<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Reset your password | Readora</title>
</head>
<body>
    <main class="card">
        <div class="eyebrow">Account recovery</div>
        <h1>Forgot your password?</h1>
        <p class="hint">Enter the email address on your account to get a password reset token.</p>
        <form action="/password-reset-user" method="post">
            <label for="userEmail">Email address</label>
            <input type="email" name="email" id="userEmail" autocomplete="email" required>
            <button type="submit">Continue</button>
        </form>
        <p class="links"><a href="/user/login">Back to login</a></p>
    </main>
</body>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Password reset</title>
</head>
<body>
    <main>
        <h1>Password reset token</h1>
        <p>Use this token to reset your password. It expires in 10 minutes.</p>
        <p><code>{{token}}</code></p>
        <p><a href="{{resetUrl}}">Continue to reset password</a></p>
    </main>
</body>
</html>

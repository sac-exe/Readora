<!DOCTYPE html>
<html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Edit {{novel.title}}</title>
<style>body{margin:0;background:#070b1d;color:#fff;font-family:Arial,sans-serif}.wrap{max-width:1000px;margin:auto;padding:24px}.back{color:#fff}.card{background:#101425;border:1px solid #303a65;border-radius:12px;padding:20px;margin:16px 0}input,textarea,select{box-sizing:border-box;width:100%;margin:7px 0 15px;padding:10px;background:#18203b;border:1px solid #46527c;color:#fff;border-radius:6px}textarea{min-height:130px}button{padding:9px 13px;border:0;border-radius:6px;color:#fff;background:#5865f2;cursor:pointer}.danger{background:#b83232}.msg{color:#8ef3a5}.grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}.cover{width:120px;height:165px;object-fit:cover;border-radius:8px}.chapter{border-top:1px solid #303a65;padding:14px 0}.chapter form{display:inline}.chapter textarea{min-height:90px}@media(max-width:650px){.grid{grid-template-columns:1fr}}</style></head>
<body><main class="wrap"><a class="back" href="/admin/books">← Manage novels</a><h1>Edit novel</h1>{{#if message}}<p class="msg">{{message}}</p>{{/if}}
<section class="card"><form action="/admin/books/{{novel._id}}/edit" method="POST" enctype="multipart/form-data"><img class="cover" src="{{novel.imageUrl}}" alt="Cover"><label>Replace cover<input type="file" name="cover" accept=".jpg,.jpeg,.png,.webp"></label><div class="grid"><label>Title<input name="title" value="{{novel.title}}" required></label><label>Author<input name="author" value="{{novel.author}}" required></label><label>Status<input name="status" value="{{novel.status}}"></label><label>Category<input name="category" value="{{novel.categ}}"></label><label>Audience<input name="audience" value="{{novel.audience}}"></label><label>Tags<input name="hashtags" value="{{novel.tag}}"></label><label>Original language<input name="originalLanguage" value="{{novel.orglang}}"></label><label>Translated language<input name="translatedLanguage" value="{{novel.tralang}}"></label></div><label>Description<textarea name="description">{{novel.description}}</textarea></label><button type="submit">Save novel</button></form></section>
<section class="card"><h2>Add chapter</h2><form action="/admin/books/{{novel._id}}/chapters" method="POST"><div class="grid"><label>Chapter number<input type="number" name="chapterNumber" required></label><label>Title<input name="title" required></label></div><label>Content<textarea name="content" required></textarea></label><button type="submit">Add chapter</button></form></section>
<section class="card"><h2>Chapters</h2>{{#each chapters}}<div class="chapter"><form action="/admin/chapters/{{this._id}}/edit" method="POST"><div class="grid"><label>Number<input type="number" name="chapterNumber" value="{{this.chapterNumber}}"></label><label>Title<input name="title" value="{{this.title}}"></label></div><textarea name="content">{{this.content}}</textarea><button type="submit">Save chapter</button></form><form action="/admin/chapters/{{this._id}}/delete" method="POST" onsubmit="return confirm('Delete this chapter?')"><button class="danger" type="submit">Delete chapter</button></form></div>{{else}}<p>No chapters yet.</p>{{/each}}</section>
<form action="/admin/books/{{novel._id}}/delete" method="POST" onsubmit="return confirm('Delete the novel, every chapter, and all comments?')"><button class="danger" type="submit">Delete novel permanently</button></form></main></body></html>

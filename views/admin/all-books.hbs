<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>All Books | Admin</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <!-- Ionicons SVG CDN -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/ionicons@7.1.0/dist/ionicons.min.css" />
  <style>
    body {
      background-color: #070b1d;
      color: #fff;
    }
    @media (max-width:900px) {
      body{
        height: auto;
        width: 100%;
      }
    }
    .novel-info-admin-dash{
      width: 80%;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }
    .novel-all-admin {
      border: 1px solid #fff;
      color: #fff;
      border-radius: 1rem;
      display: flex;
      padding: 0 1rem 0 0;
      background-color: #101425;
      transition: transform 0.3s ease, box-shadow 0.3s ease;
      width: 100%;
      height: 15rem;
      overflow: hidden;
    }
    .novel-title-admin {
      font-size: 1.2rem;
      font-family: 'sansation';
      font-weight: 600;
      margin-bottom: 0.5rem;
      color: #fff;
    }
    .chapters-count-admin{
      color: #a4a5bd;
    }
    .icon-delete-admin {
      background: none;
      border: none;
      color: #ff5219;
      cursor: pointer;
      font-size: 1rem;
      padding: 0.5rem;
      margin-bottom: 0.8rem;
    }

    .icon-delete-admin:hover {
      color: red;
      transition: color 0.3s ease;
      transform: scale(1.05);
    }
    .cover-upload-admin { display: flex; gap: .5rem; align-items: center; flex-wrap: wrap; }
    .cover-upload-admin input { max-width: 185px; color: #fff; font-size: .78rem; }
    .cover-upload-admin button { border: 0; border-radius: .45rem; padding: .45rem .7rem; background: #5865f2; color: #fff; cursor: pointer; }
    .cover-upload-admin button:hover { background: #7480ff; }
    .cover-message { margin: 0 auto 1rem; max-width: 900px; color: #8ef3a5; text-align: center; }
  </style>
</head>
<body>
  <div class="container-all-users">
    <button class="back-button" onclick="window.location.href='/admin/home'"><i class="fas fa-arrow-left"></i></button>
    <div class="page-header-all-users">All Novels</div>
    {{#if coverMessage}}<div class="cover-message">{{coverMessage}}</div>{{/if}}
    <div class="users-grid-all-users">
      {{#each novels}}
      <div class="novel-all-admin" data-title="{{this.title}}">
        <img src="{{this.imageUrl}}" alt="{{this.title}}" class="img-novel-staff">
        <div class="novel-info-admin-dash">
          <div>
            <div class="novel-title-admin">{{this.title}}</div>
            <div class="novel-author-staff-dash">Author: {{this.author}}</div>
            <div class="novel-description-staff-dash">{{this.description}}</div>
            <div class="novel-meta-staff-dash">
              <span class="chapters-count-admin">{{this.chapters}} Chapters</span>
              <span class="status-badge">{{this.status}}</span>
              <span class="rating-badge">{{this.audience}}</span>
              <span class="language-badge">{{this.orglang}}</span>
              <i class="fa-solid fa-arrow-right-arrow-left"></i>
              <span class="language-badge">{{this.tralang}}</span>
            </div>
            <div class="novel-author-staff-dash">Translation done by: {{this.staff}}</div>
          </div>
          <div class="novel-actions-staff-dash">
            <a href="/admin/books/{{this._id}}/edit" class="cover-upload-admin"><button type="button"><i class="fa-solid fa-pen"></i> Edit novel</button></a>
            <form action="/admin/books/{{this._id}}/cover" method="POST" enctype="multipart/form-data" class="cover-upload-admin">
              <input type="file" name="cover" accept=".jpg,.jpeg,.png,.webp" required>
              <button type="submit"><i class="fa-solid fa-image"></i> Upload cover</button>
            </form>
            <form action="/admin/books/{{this._id}}/delete" method="POST" class="inline-form" onsubmit="return confirm('Delete this novel, its chapters, and comments?');">
              <button type="submit" class="icon-delete">
                <i class="fa-solid fa-trash-can"></i>
              </button>
            </form>
          </div>
        </div>
      </div>
    {{/each}}
    </div>
  </div>
</body>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Profile: {{name}}</title>
</head>
<body>
    <div class="bg-user-home ">
        <div class="container-home">
            <nav class="navbar">
                <!-- Left Section - Home Icon -->
                <div class="nav-home">
                    <a href="/staff" class="icon-navbar">
                        <i class="fas fa-home"></i>
                    </a>
                </div>
                
                <!-- Right Section - Buttons (visible on laptop) -->
                <div class="nav-buttons">
                    <div class="navbar-coins">
                        <i class="fa-duotone fa-solid fa-coins" style="color:#ffca0a;"></i>
                        <span id="navbarCoinCount">{{coinCount}}</span>
                    </div>
                    <button class="icon-navbar"  id="theme-switch">
                        <svg xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#e3e3e3"><path d="M480-120q-150 0-255-105T120-480q0-150 105-255t255-105q14 0 27.5 1t26.5 3q-41 29-65.5 75.5T444-660q0 90 63 153t153 63q55 0 101-24.5t75-65.5q2 13 3 26.5t1 27.5q0 150-105 255T480-120Z"/></svg>
                        <svg xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#e3e3e3"><path d="M480-280q-83 0-141.5-58.5T280-480q0-83 58.5-141.5T480-680q83 0 141.5 58.5T680-480q0 83-58.5 141.5T480-280ZM200-440H40v-80h160v80Zm720 0H760v-80h160v80ZM440-760v-160h80v160h-80Zm0 720v-160h80v160h-80ZM256-650l-101-97 57-59 96 100-52 56Zm492 496-97-101 53-55 101 97-57 59Zm-98-550 97-101 59 57-100 96-56-52ZM154-212l101-97 55 53-97 101-59-57Z"/></svg>
                    </button>
                    <button class="icon-navbar" onclick="window.open('/staff-shop')"><i class="fa-solid fa-cart-shopping"></i></button>
                    <button class="icon-navbar"><i class="fab fa-discord"></i></button>
                    <button class="icon-navbar" onclick="window.location.href='/staff/bookmarks'">
                        <i class="fa-solid fa-book-bookmark"></i>
                    </button>
                    <button class="icon-navbar" onclick="window.location.href='/staff/list'">
                        <i class="fa-solid fa-users"></i>
                    </button>
                    <div class="profile-button">
                        {{#if viewer}}
                        <div class="user-dropdown">
                        <div class="user-avatar" style="position:relative;display:inline-block;width:48px;height:48px;" onclick="toggleStaffCarddesktop()">
                            {{#if viewer.profileFrame}}
                                <img class="avatar-frame" src="/frames/{{viewer.profileFrame}}.png" alt="Frame">
                            {{/if}}
                            {{#if viewer.profileImageUrl}}
                                <img class="avatar-img" src="{{viewer.profileImageUrl}}" alt="Profile">
                            {{else}}
                                <div class="avatar-initial">{{viewer.Username.[0]}}</div>
                            {{/if}}
                        </div>
                        <div id="userCarddesktop" class="user-card">
                            <div class="user-card-header">
                                <div class="user-avatar-large">
                                    {{#if viewer.profileImageUrl}}
                                        <img src="{{viewer.profileImageUrl}}?{{now}}" alt="Profile" style="width:65px;height:65px;border-radius:50%;object-fit:cover;">
                                    {{else}}
                                        {{viewer.Username.[0]}}
                                    {{/if}}
                                </div>
                            <div>
                                <div class="user-name">{{viewer.Username}}</div>
                            </div>
                        </div>
                        <div class="user-card-actions">
                            <a href="/staff/profile" class="user-card-link"><i class="fa-solid fa-user"></i> Profile</a>
                            <a href="/staff/dash" class="user-card-link"><i class="fa-solid fa-pen-fancy"></i> Author Dashboard</a>
                            <a href="/staff/logout" class="user-card-link"><i class="fa-solid fa-right-from-bracket"></i> Logout</a>
                        </div>
                    </div>
                        </div>
                        {{else}}
                        <button class="btn-navnar d-flex align-items-center gap-1" onclick="window.open('/staff/login')">
                        <i class="fas fa-user"></i> Sign in/up
                        </button>
                        {{/if}}
                    </div>
                </div>
                
                <!-- Mobile Right Section (hidden on laptop) -->
                <div class="mobile-right">
                    <button class="mobile-menu-btn" id="mobileMenuBtn">
                        <i class="fas fa-bars"></i>
                    </button>
                    <div class="profile-button">
                        {{#if viewer}}

                        <div class="user-dropdown">
                        <div class="user-avatar" style="position:relative;display:inline-block;width:48px;height:48px;" onclick="toggleStaffCardmobile()">
                            {{#if viewer.profileFrame}}
                                <img class="avatar-frame" src="/frames/{{viewer.profileFrame}}.png" alt="Frame">
                            {{/if}}
                            {{#if viewer.profileImageUrl}}
                                <img class="avatar-img" src="{{viewer.profileImageUrl}}" alt="Profile">
                            {{else}}
                                <div class="avatar-initial">{{viewer.Username.[0]}}</div>
                            {{/if}}
                        </div>
                        <div id="userCardmobile" class="user-card">
                            <div class="user-card-header">
                            <div class="user-avatar-large">
                                {{#if viewer.profileImageUrl}}
                                    <img src="{{viewer.profileImageUrl}}?{{now}}" alt="Profile" style="width:65px;height:65px;border-radius:50%;object-fit:cover;">
                                {{else}}
                                    {{viewer.Username.[0]}}
                                {{/if}}
                            </div>
                            <div>
                                <div class="user-name">{{viewer.Username}}</div>
                            </div>
                            </div>
                            <div class="user-card-actions">
                            <a href="/user/profile" class="user-card-link"><i class="fa-solid fa-user"></i> Profile</a>
                            <a href="/staff/dash" class="user-card-link"><i class="fa-solid fa-pen-fancy"></i> Author Dashboard</a>
                            <a href="/staff/logout" class="user-card-link"><i class="fa-solid fa-right-from-bracket"></i> Logout</a>
                            </div>
                        </div>
                        </div>
                        {{else}}
                        <button class="btn-navnar d-flex align-items-center gap-1" onclick="window.open('/staff/login')">
                        <i class="fas fa-user"></i> Sign in/up
                        </button>
                        {{/if}}
                    </div>
                </div>
                <!-- Mobile Dropdown Menu Content -->
                <div class="mobile-menu" id="mobileMenu">
                    <div class="mobile-menu-row">
                        <div class="navbar-coins">
                        <i class="fa-duotone fa-solid fa-coins" style="color:#ffca0a;"></i>
                        <span id="navbarCoinCount">{{coinCount}}</span>
                    </div>
                        <button class="icon-navbar" id="theme-switch">
                        <svg xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#e3e3e3">
                            <path d="M480-120q-150 0-255-105T120-480q0-150 105-255t255-105q14 0 27.5 1t26.5 3q-41 29-65.5 75.5T444-660q0 90 63 153t153 63q55 0 101-24.5t75-65.5q2 13 3 26.5t1 27.5q0 150-105 255T480-120Z"/>
                        </svg>
                        <svg xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#e3e3e3">
                            <path d="M480-280q-83 0-141.5-58.5T280-480q0-83 58.5-141.5T480-680q83 0 141.5 58.5T680-480q0 83-58.5 141.5T480-280ZM200-440H40v-80h160v80Zm720 0H760v-80h160v80ZM440-760v-160h80v160h-80Zm0 720v-160h80v160h-80ZM256-650l-101-97 57-59 96 100-52 56Zm492 496-97-101 53-55 101 97-57 59Zm-98-550 97-101 59 57-100 96-56-52ZM154-212l101-97 55 53-97 101-59-57Z"/>
                        </svg>
                        </button>
                        <button class="icon-navbar" onclick="window.open('/staff-shop')"><i class="fa-solid fa-cart-shopping"></i></button>
                        <button class="icon-navbar"><i class="fab fa-discord"></i></button>
                        <button class="icon-navbar" onclick="window.location.href='/staff/bookmarks'" ><i class="fa-solid fa-book-bookmark"></i></button>
                        <button class="icon-navbar" onclick="window.location.href='/staff/list'">
                            <i class="fa-solid fa-users"></i>
                        </button>
                    </div>
                </div>
            </nav>
            <section class="sp-wrap">
                <header class="sp-head">
                    <div class="stf-profile">
                        <div class="rd-cform-head">
                            <div class="user-avatar" style="position:relative;display:inline-block;width:48px;height:48px;">
                                {{#if profileFrame}}
                                    <img class="avatar-frame" src="/frames/{{profileFrame}}.png" alt="Frame">
                                {{/if}}
                                {{#if profileImageUrl}}
                                    <img class="avatar-img" src="{{profileImageUrl}}" alt="Profile">
                                {{else}}
                                    <div class="avatar-initial">{{this.name.[0]}}</div>
                                {{/if}}
                            </div>
                            <div class="rd-cform-meta">
                                <div class="rd-cform-name">{{this.name}}</div>
                                <div class="rd-cform-hint">{{this.novelCount}} Novels</div>
                            </div>
                        </div>
                    </div>
                    <div class="sp-links">
                        <p class="sp-links-head">Support links</p>

                        {{#if kofi}}
                            <div class="sp-link">
                                <i class="fa-solid fa-mug-hot"></i>
                                <span class="sp-link-label">Ko‑fi:</span>
                                <a class="sp-kofi" href="{{kofi}}" target="_blank" rel="noopener" title="Ko‑fi: {{kofi}}">
                                    <span class="sp-link-host">{{kofi}}</span>
                                </a>
                            </div>
                        {{/if}}

                        {{#if patreon}}
                            <div class="sp-link">
                                <i class="fa-brands fa-patreon"></i>
                                <span class="sp-link-label">Patreon:</span>
                                <a class="sp-patreon" href="{{patreon}}" target="_blank" rel="noopener" title="Patreon: {{patreon}}">
                                    <span class="sp-link-host">{{patreon}}</span>
                                </a>
                            </div>
                        {{/if}}
                    </div>
                    
                    {{!-- <div class="sp-gift">
                        {{#if viewer}}
                            {{#if (eq viewer._id staffId)}}
                            <div class="sp-gift-blocked" role="alert">
                                Cannot gift coins to own profile. 
                            </div>
                            {{else}}
                            <form class="sp-gift-form" method="POST" action="/staff/{{staffId}}/gift" onsubmit="return validateGiftAmount(event)">
                                <label class="sp-gift-field">
                                    <span>Gift coins</span>
                                    <input
                                        type="number"
                                        name="amount"
                                        id="giftAmount"
                                        min="1"
                                        step="1"
                                        placeholder="Amount"
                                        required
                                        aria-describedby="giftHelp"
                                    >
                                </label>
                                <button type="submit" class="sp-gift-btn">
                                    <i class="fa-solid fa-coins"></i> Send
                                </button>
                            </form>
                            <script>
                                function validateGiftAmount(e) {
                                    const input = document.getElementById('giftAmount');
                                    const amount = parseInt(input.value, 10) || 0;
                                    const available = {{viewer.coins}};
                                    
                                    if (amount <= 0) {
                                        alert('Enter a positive amount.');
                                        e.preventDefault();
                                        return false;
                                    }
                                    if (amount > available) {
                                        alert('Insufficient coins. You have ' + available + ' coins available.');
                                        e.preventDefault();
                                        return false;
                                    }
                                    return true;
                                }
                            </script>
                            {{/if}}
                        {{else}}
                            <div class="sp-gift-login">
                                Sign in to send coins.
                            </div>
                        {{/if}}
                    </div> --}}
                   
                </header>

                {{#if novels.length}}
                <section class="sp-shelf">
                    <h2 class="sp-shelf-title">Novels by {{name}}</h2>
                    <div class="sp-track">
                    {{#each novels}}
                        <a class="sp-novel" href="/novel/{{this.id}}" title="{{this.title}}">
                        <div class="sp-cover" style="--cover:url('{{this.imageUrl}}')"></div>
                        <div class="sp-ntitle">{{this.title}}</div>
                        </a>
                    {{/each}}
                    </div>
                </section>
                {{/if}}
            </section>
            <div class=" bottom-card">
                <div class="sec-1-bottom-card">
                    <div class="logo-bottom"></div>
                    <div>
                        <h4>Explore books, embrace stories</h4>
                        <p>
                            REDORA is a user-friendly book translation platform designed to make global reading accessible.
                        </p>
                    </div>
                </div>
                <div class="d-flex flex-column sec-2-bottom-card">
                    <h5>Quick Links</h5>
                    <a href="/">Home</a>
                    <a href="about.html">About</a>
                </div>
                <div class="d-flex flex-column sec-2-bottom-card">
                    <h5>Policies</h5>
                    <a href="/terms/privacy policy.pdf" target="_blank">Privacy Policy</a>
                    <a href="/terms/terms and service.pdf" target="_blank">Terms of Service</a>
                    <a href="/terms/Translation Policy READORA.pdf" target="_blank">Translation Policy</a>
                </div>
                <div class="d-flex flex-column sec-2-bottom-card">
                    <h5>Help</h5>
                    <a href="mailto:readoraofficial@gmail.com">Support</a>
                </div>
                <!-- Footer -->
            </div>
            <div class="footer-bottom ">
                <small>
                    © 2025 READORA LLC, an Expedia Group company. All rights reserved.
                </small>
            </div>
            {{#if success}}
                <div class="alert alert-success" style="background: #d4edda; color: #155724; padding: 12px; border-radius: 4px; margin-bottom: 20px; border: 1px solid #c3e6cb;">
                    <i class="fa-solid fa-check-circle"></i> {{success}}
                </div>
            {{/if}}
                
            {{#if error}}
                <div class="alert alert-error" style="background: #f8d7da; color: #721c24; padding: 12px; border-radius: 4px; margin-bottom: 20px; border: 1px solid #f5c6cb;">
                    <i class="fa-solid fa-exclamation-circle"></i> {{error}}
                </div>
            {{/if}}
        </div>
    </div>

    <script>
        function toggleStaffCarddesktop() {
        const card = document.getElementById('userCarddesktop');
        card.style.display = card.style.display === 'block' ? 'none' : 'block';
        }

        function toggleStaffCardmobile() {
        const card = document.getElementById('userCardmobile');
        card.style.display = card.style.display === 'block' ? 'none' : 'block';
        }

        // Close BOTH cards if clicked outside
        document.addEventListener('click', function(event) {
        const avatarDesktop = document.querySelector('#userCarddesktop')?.previousElementSibling;
        const cardDesktop = document.getElementById('userCarddesktop');

        const avatarMobile = document.querySelector('#userCardmobile')?.previousElementSibling;
        const cardMobile = document.getElementById('userCardmobile');

        const clickedInsideDesktop = cardDesktop?.contains(event.target) || avatarDesktop?.contains(event.target);
        const clickedInsideMobile = cardMobile?.contains(event.target) || avatarMobile?.contains(event.target);

        if (!clickedInsideDesktop && cardDesktop) cardDesktop.style.display = 'none';
        if (!clickedInsideMobile && cardMobile) cardMobile.style.display = 'none';
        });
    </script>

    <script>
        let darkmode = localStorage.getItem('darkmode')
        const themeSwitches = document.querySelectorAll('#theme-switch')

        const enableDarkmode = () => {
        document.body.classList.add('darkmode') 
        localStorage.setItem('darkmode', 'active')
        }

        const disableDarkmode = () => {
        document.body.classList.remove('darkmode')
        localStorage.setItem('darkmode', null)
        }

        if (darkmode === "active") enableDarkmode()

        themeSwitches.forEach(btn => {
        btn.addEventListener("click", () => {
            darkmode = localStorage.getItem('darkmode')
            darkmode !== "active" ? enableDarkmode() : disableDarkmode()
        })
        })
    </script>

    <script>
        // Toggle mobile menu
        const mobileMenuBtn = document.getElementById('mobileMenuBtn');
        const mobileMenu = document.getElementById('mobileMenu');
        
        mobileMenuBtn.addEventListener('click', (e) => {
        e.stopPropagation(); // Prevent immediate closing
        mobileMenu.classList.toggle('active');
        });
        
        // Close mobile menu when clicking outside
        document.addEventListener('click', (e) => {
        if (!mobileMenu.contains(e.target) && e.target !== mobileMenuBtn) {
            mobileMenu.classList.remove('active');
        }
        });
        
        // Prevent mobile menu from closing when clicking inside it
        mobileMenu.addEventListener('click', (e) => {
        e.stopPropagation();
        });
    </script>

</body>
</html>

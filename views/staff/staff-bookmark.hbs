                        </button>
                        <form method="POST" action="/staff/bookmark/remove" style="display:inline;">
                            <input type="hidden" name="novelId" value="{{_id}}">
                            <button class="rd-bm-btn rd-bm-btn--danger" type="submit">
                            <i class="fa-solid fa-trash"></i> Remove

        <script>
            // Shortcuts
            document.addEventListener('keydown', (e) => {
                const k = e.key.toLowerCase();

                if (e.ctrlKey && k === 'b') {
                    e.preventDefault();
                    exec('bold');
                }
                if (e.ctrlKey && k === 'i') {
                    e.preventDefault();
                    exec('italic');
                }
                if (e.ctrlKey && k === 'u') {
                    e.preventDefault();
                    exec('underline');
                }
                if (e.ctrlKey && k === 'k') {
                    e.preventDefault();
                    saveSelection();
                    setTimeout(() => {
                        restoreSelection();
                        const url = prompt('Enter URL (https://...)');
                        if (url) exec('createLink', url);
                    }, 0);
                }
            });

            // Save/Publish/Close/Back
            function collectData() {
                return {
                    chapterNumber: Number(document.getElementById('chapterNumber').value || 0),
                    partNumber: Number(document.getElementById('partNumber').value || 0),
                    extra: document.getElementById('extra').value.trim(),
                    title: document.getElementById('title').value.trim(),
                    audience: document.getElementById('audience').value,
                    html: editor.innerHTML,
                    text: editor.innerText,
                    wordCount: Number(wordCountEl.textContent)
                };
            }

            function flash(msg) {
                const el = document.createElement('div');
                el.className = 'toast';
                el.textContent = msg;
                document.body.appendChild(el);

                setTimeout(() => el.classList.add('show'), 10);
                setTimeout(() => {
                    el.classList.remove('show');
                    setTimeout(() => el.remove(), 250);
                }, 2200);
            }

            const toastStyle = document.createElement('style');
            toastStyle.textContent = `
            .toast {
                position: fixed;
                left: 50%;
                bottom: 22px;
                transform: translateX(-50%) translateY(20px);
                background: #0b1324;
                color: #e6ecff;
                border: 1px solid #233049;
                padding: 10px 14px;
                border-radius: 10px;
                opacity: 0;
                transition: .22s ease;
                box-shadow: 0 10px 30px rgba(0,0,0,.45);
                z-index: 9999;
            }
            .toast.show {
                opacity: 1;
                transform: translateX(-50%) translateY(0);
            }
            `;
            document.head.appendChild(toastStyle);

            document.getElementById('btnPublish').addEventListener('click', async () => {
            // prefer server-provided NOVEL_ID, fallback to query param
            const urlParams = new URLSearchParams(window.location.search);
            const novelId = NOVEL_ID || urlParams.get('novelId');
            const title = document.getElementById('chapterTitle').value;
            const chapterNumber = document.getElementById('chapterNumber').value;
            const html = document.getElementById('editor').innerHTML;
            const scheduleDate = document.getElementById('chapterSheduleDate')?.value || null;

            if (!novelId) return alert('Novel ID missing!');
            if (!chapterNumber || !html.trim()) return alert('Chapter number and content required!');

            const res = await fetch(`/staff/novels/${novelId}/chapters`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ chapterNumber, title, html, scheduleDate })
            });

            if (res.ok) {
            alert('Chapter published!');
            window.location.href = `/staff/novels/${novelId}/edit`;
            } else {
            const data = await res.json().catch(()=>({ error: 'Server error' }));
            alert('Failed to publish chapter: ' + (data.error || 'Unknown error'));
            }
        });

            document.getElementById('btnBack').addEventListener('click', () => history.back());

            // Schedule dialog
            const scheduleDialog = document.getElementById('scheduleDialog');
            document.getElementById('btnSchedule').addEventListener('click', () => scheduleDialog.showModal());

            document.getElementById('confirmSchedule').addEventListener('click', (e) => {
                const d = document.getElementById('schedDate').value;
                const t = document.getElementById('schedTime').value;

                if (!d || !t) {
                    e.preventDefault();
                    alert('Select both date and time.');
                    return;
                }
                flash(`Scheduled for ${d} ${t}`);
            });
        </script>

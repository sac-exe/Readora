        <script>
            // Find & Replace
            const findDialog = document.getElementById('findDialog');
            let currentMatch = null;
            let allMatches = []; // Store all matches globally
            let currentMatchIndex = -1; // Track current match position

            // Keyboard shortcut to open find dialog
            document.addEventListener('keydown', (e) => {
                if (e.ctrlKey && e.key.toLowerCase() === 'f') {
                    e.preventDefault();
                    saveSelection();
                    findDialog.showModal();
                    document.getElementById('findText').focus();
                }
            });

            function escapeRegExp(s) {
                return s.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
            }

            function clearHighlights() {
                const highlights = editor.querySelectorAll('.search-highlight');
                highlights.forEach(el => {
                    const parent = el.parentNode;
                    parent.replaceChild(document.createTextNode(el.textContent), el);
                    parent.normalize();
                });
            }

            function highlightMatch(node, start, end) {
                const range = document.createRange();
                range.setStart(node, start);
                range.setEnd(node, end);
                
                const span = document.createElement('span');
                span.className = 'search-highlight';
                span.style.backgroundColor = 'rgba(255, 255, 0, 0.3)';
                range.surroundContents(span);
                return span;
            }

            function findAllMatches() {
                const findVal = document.getElementById('findText').value;
                if (!findVal) return [];
                
                const pattern = new RegExp(escapeRegExp(findVal), 'gi');
                const matches = [];
                const walker = document.createTreeWalker(editor, NodeFilter.SHOW_TEXT);
                let node;
                
                while (node = walker.nextNode()) {
                    const text = node.textContent;
                    let match;
                    while ((match = pattern.exec(text)) !== null) {
                        matches.push({
                            node: node,
                            start: match.index,
                            end: match.index + match[0].length,
                            text: match[0]
                        });
                    }
                }
                
                return matches;
            }

            function findNext() {
                // Refresh matches each time to account for content changes
                allMatches = findAllMatches();
                
                if (allMatches.length === 0) {
                    alert('No matches found');
                    return false;
                }
                
                clearHighlights();
                
                // Move to next match (or first if none selected)
                currentMatchIndex = (currentMatchIndex + 1) % allMatches.length;
                const match = allMatches[currentMatchIndex];
                
                const span = highlightMatch(match.node, match.start, match.end);
                span.scrollIntoView({ behavior: 'smooth', block: 'center' });
                
                const range = document.createRange();
                range.selectNodeContents(span);
                const selection = window.getSelection();
                selection.removeAllRanges();
                selection.addRange(range);
                
                currentMatch = {
                    node: match.node,
                    start: match.start,
                    end: match.end,
                    text: match.text,
                    span: span
                };
                
                return true;
            }

            function replaceCurrent(replacement) {
                if (!currentMatch) {
                    if (!findNext()) return false;
                }
                
                // Create new text node with replacement
                const newNode = document.createTextNode(replacement);
                
                // Replace the content
                if (currentMatch.span && currentMatch.span.parentNode) {
                    currentMatch.span.parentNode.replaceChild(newNode, currentMatch.span);
                } else {
                    const range = document.createRange();
                    range.setStart(currentMatch.node, currentMatch.start);
                    range.setEnd(currentMatch.node, currentMatch.end);
                    range.deleteContents();
                    range.insertNode(newNode);
                }
                
                // Clear current match and reset index
                currentMatch = null;
                currentMatchIndex = -1;
                return true;
            }

            function replaceAll() {
                const replVal = document.getElementById('replaceText').value || '';
                const matches = findAllMatches();
                
                if (matches.length === 0) {
                    alert('No matches found');
                    return;
                }
                
                // Replace from last to first to avoid offset issues
                for (let i = matches.length - 1; i >= 0; i--) {
                    const match = matches[i];
                    const range = document.createRange();
                    range.setStart(match.node, match.start);
                    range.setEnd(match.node, match.end);
                    range.deleteContents();
                    range.insertNode(document.createTextNode(replVal));
                }
                
                flash(`Replaced ${matches.length} occurrences`);
                currentMatch = null;
                currentMatchIndex = -1;
            }

            // Event Listeners
            document.getElementById('btnFindNext').addEventListener('click', findNext);

            document.getElementById('btnReplace').addEventListener('click', function(e) {
                e.preventDefault();
                const replacement = document.getElementById('replaceText').value || '';
                if (replaceCurrent(replacement)) {
                    findNext(); // Auto-find next after successful replace
                }
            });

            document.getElementById('btnReplaceAll').addEventListener('click', replaceAll);

            // Fix close button
            document.getElementById('closefinddialoge').addEventListener('click', function() {
                findDialog.close();
                clearHighlights();
                currentMatch = null;
                currentMatchIndex = -1;
            });

            // Close dialog when clicking outside
            findDialog.addEventListener('click', function(e) {
                if (e.target === findDialog) {
                    findDialog.close();
                    clearHighlights();
                    currentMatch = null;
                    currentMatchIndex = -1;
                }
            });
        </script>

                                    <button type="button" class="tbtn" id="imgAlignLeft" title="Image Left"><i class="fa-solid fa-align-left"></i></button>
                                    <button type="button" class="tbtn" id="imgAlignCenter" title="Image Center"><i class="fa-solid fa-align-center"></i></button>

        </div>
        <script>//small client side validation
            document.getElementById('create-chapter-form').addEventListener('submit', function(e) {
            const requiredFields = [
                'chapternum',
                'chaptercontent'
            ];
            let valid = true;
            requiredFields.forEach(id => {
                const el = document.getElementsByName(id)[0];
                if (!el || !el.value.trim()) {
                valid = false;
                el && el.classList.add('input-error');
                } else {
                el && el.classList.remove('input-error');
                }
            });
            if (!valid) {
                alert('Please fill all required fields.');
                e.preventDefault();
            }
            });
        </script>
        <script>
            // Sidebar responsive behavior
            document.addEventListener('DOMContentLoaded', function () {
                const menuToggle = document.getElementById('menuToggle');
                const sidebar = document.getElementById('sidebar');
                const collapseBtn = document.getElementById('collapseBtn');

                function handleDesktop() {
                    menuToggle.style.display = 'none';
                    collapseBtn.style.display = 'block';

                    collapseBtn.onclick = function (e) {
                        e.stopPropagation();
                        sidebar.classList.toggle('collapsed');

                        const icon = collapseBtn.querySelector('i');
                        if (sidebar.classList.contains('collapsed')) {
                            icon.classList.replace('fa-chevron-left', 'fa-chevron-right');
                        } else {
                            icon.classList.replace('fa-chevron-right', 'fa-chevron-left');
                        }
                    };
                }

                function handleMobile() {
                    menuToggle.style.display = 'block';
                    collapseBtn.style.display = 'none';

                    menuToggle.onclick = () => sidebar.classList.add('show');
                    document.addEventListener('click', function (e) {
                        if (!sidebar.contains(e.target) && e.target !== menuToggle) {
                            sidebar.classList.remove('show');
                        }
                    });
                }

                function checkScreenSize() {
                    if (window.innerWidth > 768) handleDesktop();
                    else handleMobile();
                }

                checkScreenSize();
                window.addEventListener('resize', checkScreenSize);
            });

            // Editor logic
            let savedRange = null;

            function saveSelection() {
                const sel = window.getSelection();
                if (sel && sel.rangeCount > 0) savedRange = sel.getRangeAt(0);
            }

            function restoreSelection() {
                if (!savedRange) return;
                const sel = window.getSelection();
                sel.removeAllRanges();
                sel.addRange(savedRange);
            }

            const editor = document.getElementById('editor');
            const wordCountEl = document.getElementById('wordCount');
            const preview = document.getElementById('preview');

            function exec(cmd, value = null) {
                document.execCommand(cmd, false, value);
                editor.focus();
                updateWordCount();
            }

            function setBlock(tag) {
                document.execCommand('formatBlock', false, tag);
                editor.focus();
            }

            document.querySelectorAll('.tbtn[data-cmd]').forEach(btn => {
                btn.addEventListener('click', () => exec(btn.dataset.cmd));
            });

            document.getElementById('btnH1').addEventListener('click', () => setBlock('H1'));
            document.getElementById('btnH2').addEventListener('click', () => setBlock('H2'));
            document.getElementById('btnParagraph').addEventListener('click', () => setBlock('P'));

            function insertHorizontalRule() {
                // Clear image selection overlays if present
                if (typeof clearImgSelection === 'function') clearImgSelection();

                editor.focus();

                // Ensure we have a valid caret/range inside editor
                const sel = window.getSelection();
                let range;
                if (sel && sel.rangeCount > 0) {
                    range = sel.getRangeAt(0);
                } else {
                    range = document.createRange();
                    range.selectNodeContents(editor);
                    range.collapse(false);
                    sel.removeAllRanges();
                    sel.addRange(range);
                }

                // Create <hr> and insert
                const hr = document.createElement('hr');
                range.deleteContents();
                range.insertNode(hr);

                // Place caret after the HR by inserting a zero-width space and selecting it
                const zwsp = document.createTextNode('\u200B');
                hr.insertAdjacentElement('afterend', document.createElement('br')); // optional line break
                hr.parentNode.insertBefore(zwsp, hr.nextSibling);

                range.setStartAfter(zwsp);
                range.setEndAfter(zwsp);
                sel.removeAllRanges();
                sel.addRange(range);

                if (typeof updateWordCount === 'function') updateWordCount();
                if (typeof updateButtonStates === 'function') updateButtonStates();
                }

                const btnHR = document.getElementById('btnHR');
                btnHR.addEventListener('mousedown', saveSelection);
                btnHR.addEventListener('click', () => {
                setTimeout(insertHorizontalRule, 0);
            });

            // Links
            const btnLink = document.getElementById('btnLink');

            btnLink.addEventListener('mousedown', saveSelection);
            btnLink.addEventListener('click', () => {
                setTimeout(() => {
                    restoreSelection();
                    const sel = window.getSelection();
                    let linkText = '';
                    if (sel && sel.rangeCount > 0 && sel.isCollapsed) {
                        linkText = prompt('Enter link text:');
                        if (!linkText) return;
                    }
                    const url = prompt('Enter URL (https://...)');
                    if (url) {
                        if (linkText) {
                            // Insert the link with the entered text
                            const a = document.createElement('a');
                            a.href = url;
                            a.textContent = linkText;
                            sel.getRangeAt(0).insertNode(a);
                        } else {
                            exec('createLink', url);
                        }
                    }
                }, 0);
            });

            // Helper: insert <a>text</a> at caret
            function insertLinkNode(text, href) {
                const sel = window.getSelection();
                if (!sel || sel.rangeCount === 0) return;

                const range = sel.getRangeAt(0);
                const a = document.createElement('a');
                a.href = href;
                a.textContent = text;

                range.deleteContents();
                range.insertNode(a);

                // Place caret after the link
                range.setStartAfter(a);
                range.setEndAfter(a);
                sel.removeAllRanges();
                sel.addRange(range);
            }

            // Helper: wrap current selection in <a href="...">
            function wrapSelectionWithLink(href) {
            const sel = window.getSelection();
            if (!sel || sel.rangeCount === 0) return;

            const range = sel.getRangeAt(0);

            // Extract contents of selection
            const contents = range.extractContents();

            // Create <a> and put the extracted nodes inside
            const a = document.createElement('a');
            a.href = href;
            a.appendChild(contents);

            // Insert <a> back where the selection was
            range.insertNode(a);

            // Reselect the link (optional) and move caret after it
            range.setStartAfter(a);
            range.setEndAfter(a);
            sel.removeAllRanges();
            sel.addRange(range);
            }


            // Images
            const imageInput = document.getElementById('imageInput');
            document.getElementById('btnImage').addEventListener('mousedown', saveSelection);
            document.getElementById('btnImage').addEventListener('click', () => imageInput.click());

            imageInput.addEventListener('change', e => {
                const file = e.target.files && e.target.files[0];
                if (!file) return;

                const reader = new FileReader();
                reader.onload = () => {
                    restoreSelection();
                    exec('insertImage', reader.result);
                    imageInput.value = '';
                };
                reader.readAsDataURL(file);
            });

            let selectedImg = null;
            let resizerEls = [];
            let isResizing = false;
            let startX = 0, startY = 0, startW = 0, startH = 0, keepRatio = true;

            function clearImgSelection(){
                if (!selectedImg) return;
                selectedImg.classList.remove('img-selected');
                resizerEls.forEach(r=>r.remove());
                resizerEls = [];
                selectedImg = null;
            }

            function addResizers(img){
                const positions = ['tl','tr','bl','br'];
                    resizerEls = positions.map(pos=>{
                    const dot = document.createElement('span');
                    dot.className = 'img-resizer ' + pos;
                    // Position using absolute on the image’s offsetParent by wrapping it
                    return dot;
                });

                // Ensure img is relatively positioned to host absolute handles
                img.style.position = 'relative';
                img.parentElement.style.position = 'relative';

                resizerEls.forEach(r=>{
                    r.style.position = 'absolute';
                    img.insertAdjacentElement('afterend', r);
                });

                // Position handles around the image box
                positionHandles();

                resizerEls.forEach(handle=>{
                    handle.addEventListener('mousedown', (e)=>{
                        e.preventDefault();
                        e.stopPropagation();
                        isResizing = true;
                        keepRatio = !e.shiftKey; // Hold Shift to free aspect ratio
                        startX = e.clientX;
                        startY = e.clientY;
                        startW = selectedImg.width;
                        startH = selectedImg.height;
                        document.addEventListener('mousemove', onResizeMove);
                        document.addEventListener('mouseup', onResizeEnd);
                    });
                });
            }

            function positionHandles(){
                if (!selectedImg || resizerEls.length===0) return;
                const rect = selectedImg.getBoundingClientRect();
                const parentRect = selectedImg.offsetParent ? selectedImg.offsetParent.getBoundingClientRect() : rect;

                const coords = {
                    tl: { left: rect.left-parentRect.left-6+'px', top: rect.top-parentRect.top-6+'px' },
                    tr: { left: rect.right-parentRect.left-6+'px', top: rect.top-parentRect.top-6+'px' },
                    bl: { left: rect.left-parentRect.left-6+'px', top: rect.bottom-parentRect.top-6+'px' },
                    br: { left: rect.right-parentRect.left-6+'px', top: rect.bottom-parentRect.top-6+'px' }
                };
                resizerEls.forEach(r=>{
                    const k = r.classList.contains('tl')?'tl':r.classList.contains('tr')?'tr':r.classList.contains('bl')?'bl':'br';
                    r.style.left = coords[k].left;
                    r.style.top = coords[k].top;
                });
            }

            function onResizeMove(e){
                if (!isResizing || !selectedImg) return;
                const dx = e.clientX - startX;
                const dy = e.clientY - startY;
                let newW = Math.max(40, startW + dx);
                let newH = keepRatio ? Math.round(startH * (newW / startW)) : Math.max(40, startH + dy);
                selectedImg.style.width = newW + 'px';
                selectedImg.style.height = newH + 'px';
                requestAnimationFrame(positionHandles);
            }

            function onResizeEnd(){
                isResizing = false;
                document.removeEventListener('mousemove', onResizeMove);
                document.removeEventListener('mouseup', onResizeEnd);
                updateWordCount();
            }

            function selectImage(img){
                if (selectedImg === img) return;
                clearImgSelection();
                selectedImg = img;
                img.classList.add('img-selected');
                addResizers(img);
            }

            function insideImage(target){
                return target && target.tagName === 'IMG';
            }

            // Click to select image
            editor.addEventListener('click', (e)=>{
                if (insideImage(e.target)) {
                selectImage(e.target);
                } else if (!e.target.classList.contains('img-resizer')) {
                clearImgSelection();
            }
            });

            // Keep handles positioned on scroll/resize/content changes
            window.addEventListener('resize', positionHandles);
            editor.addEventListener('scroll', positionHandles);
            new MutationObserver(positionHandles).observe(editor, { childList:true, subtree:true, attributes:true });

            // Delete key removes selected image
            document.addEventListener('keydown', (e)=>{
                if ((e.key === 'Delete' || e.key === 'Backspace') && selectedImg && document.activeElement !== findDialog) {
                    e.preventDefault();
                    const toRemove = selectedImg;
                    clearImgSelection();
                    toRemove.remove();
                    updateWordCount();
                }
            });

            // Alignment controls
            function clearAlign(img){
                img.classList.remove('img-left','img-right','img-center');
                img.style.display = ''; // reset if center used block
                img.style.margin = '';
                img.style.float = '';
            }
            document.getElementById('imgAlignLeft').addEventListener('click', ()=>{
                if (!selectedImg) return;
                clearAlign(selectedImg);
                selectedImg.classList.add('img-left');
                positionHandles();
            });
            document.getElementById('imgAlignCenter').addEventListener('click', ()=>{
                if (!selectedImg) return;
                clearAlign(selectedImg);
                selectedImg.classList.add('img-center');
                positionHandles();
            });
            document.getElementById('imgAlignRight').addEventListener('click', ()=>{
                if (!selectedImg) return;
                clearAlign(selectedImg);
                selectedImg.classList.add('img-right');
                positionHandles();
            });

            // Clear formatting
            document.getElementById('btnClear').addEventListener('click', function() {
                // Save the current selection
                const selection = window.getSelection();
                if (selection.rangeCount === 0) return;
                
                const range = selection.getRangeAt(0);
                
                // If nothing is selected, select the whole editor
                if (range.collapsed) {
                    range.selectNodeContents(editor);
                }
                
                // Create a document fragment to hold the cleaned content
                const fragment = range.cloneContents();
                const walker = document.createTreeWalker(
                    fragment,
                    NodeFilter.SHOW_ELEMENT,
                    null,
                    false
                );
                
                let node;
                const nodesToProcess = [];
                
                // Collect all elements that need processing
                while (node = walker.nextNode()) {
                    nodesToProcess.push(node);
                }
                
                // Process each element to remove formatting
                nodesToProcess.forEach(node => {
                    // Skip certain elements we want to preserve (like paragraphs)
                    if (node.tagName === 'P' || node.tagName === 'DIV') {
                        return;
                    }
                    
                    // Create a text node with the element's content
                    const textNode = document.createTextNode(node.textContent);
                    
                    // Replace the element with the text node
                    if (node.parentNode) {
                        node.parentNode.replaceChild(textNode, node);
                    }
                });
                
                // Delete the original content
                range.deleteContents();
                
                // Insert the cleaned content
                range.insertNode(fragment);
                
                // Restore the selection
                selection.removeAllRanges();
                selection.addRange(range);
                
                // Focus back on the editor
                editor.focus();
                
                // Update word count
                updateWordCount();
            });

            // Word count
            function updateWordCount() {
                const text = editor.innerText || '';
                const words = text.trim()
                    .replace(/[\u200B-\u200D\uFEFF]/g, '')
                    .match(/[A-Za-zÀ-ÖØ-öø-ÿ0-9']+(?:-[A-Za-z0-9']+)*/g);

                wordCountEl.textContent = words ? words.length : 0;
            }

            ['input', 'keyup', 'mouseup', 'paste', 'cut', 'drop'].forEach(evt => {
                editor.addEventListener(evt, () => {
                    updateWordCount();
                    if (previewOn) preview.innerHTML = editor.innerHTML;
                });
            });
            updateWordCount();


            const style = document.createElement('style');
            style.textContent = `
            .tbtn.active {
                background: cyan !important;
                color: #0a1020 !important;
                border-color: grey !important;
            }
            `;
            document.head.appendChild(style);

            // Modify the exec function to toggle active state
            function exec(cmd, value = null) {
                document.execCommand(cmd, false, value);
                editor.focus();
                updateWordCount();
                updateButtonStates(); // Add this line
            }

            // Add this function to update button states
            function updateButtonStates() {
                const commands = ['bold', 'italic', 'underline'];
                commands.forEach(cmd => {
                    const btn = document.querySelector(`.tbtn[data-cmd="${cmd}"]`);
                    if (btn) {
                        btn.classList.toggle('active', document.queryCommandState(cmd));
                    }
                });

                // Block type (H1, H2, P)
                let block = '';
                const sel = window.getSelection();
                if (sel && sel.rangeCount > 0) {
                    let node = sel.anchorNode;
                    while (node && node.nodeType === 3) node = node.parentNode; // climb to element
                    if (node) block = node.nodeName;
                }
                document.getElementById('btnH1').classList.toggle('active', block === 'H1');
                document.getElementById('btnH2').classList.toggle('active', block === 'H2');
                document.getElementById('btnParagraph').classList.toggle('active', block === 'P');
            }
            editor.addEventListener('input', updateButtonStates);
            editor.addEventListener('click', updateButtonStates);
            editor.addEventListener('keyup', updateButtonStates);
            document.addEventListener('DOMContentLoaded', updateButtonStates);

        </script>

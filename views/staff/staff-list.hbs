                <h1 class="stf-title">Our Translators</h1>
                <p class="stf-sub">Discover staff profiles and their latest novels</p>
                </header>

                {{#if staffList.length}}
                <div class="stf-grid">
                    {{#each staffList}}
                    <article class="stf-card">
                        <div class="stf-profile">
                            <div class="user-avatar" style="position:relative;display:inline-block;width:48px;height:48px;" onclick="toggleStaffCarddesktop()">
                                {{#if profileFrame}}
                                    <img class="avatar-frame" src="/frames/{{profileFrame}}.png" alt="Frame">
                                {{/if}}
                                {{#if profileImageUrl}}
                                    <img class="avatar-img" src="{{profileImageUrl}}" alt="Profile">
                                {{else}}
                                    <div class="avatar-initial">{{this.name.[0]}}</div>
                                {{/if}}
                            </div>
                            <a class="stf-name" title="visit profile" href="/staff/profile/{{this.id}}">{{this.name}}</a>
                            <div class="stf-count">{{this.novelCount}} Novels</div>

                        </div>

                        {{#if this.novels.length}}
                        <div class="stf-shelf" aria-label="Novels by {{this.name}}">
                            <div class="stf-track">
                            {{#each this.novels}}
                                <a class="stf-novel" href="/novel/{{this.id}}" title="{{this.title}}">
                                <div class="stf-cover" style="--cover:url('{{this.imageUrl}}')"></div>
                                <div class="stf-ntitle">{{this.title}}</div>
                                </a>
                            {{/each}}
                            </div>
                        </div>
                        {{else}}

    <script>
        (() => {
        const input = document.getElementById('rd-search-input');
        const dropdown = document.getElementById('rd-search-results');
        if (!input || !dropdown) return;

        let timer = null;
        let activeIndex = -1;

        // Debounced fetch
        function debounce(fn, delay) {
            return function(...args) {
            clearTimeout(timer);
            timer = setTimeout(() => fn.apply(this, args), delay);
            };
        }

        async function fetchResults(query) {
            if (!query || query.length < 2) {
            dropdown.hidden = true;
            input.setAttribute('aria-expanded', 'false');
            return;
            }

            try {
            const res = await fetch(`/api/search?q=${encodeURIComponent(query)}`);
            const data = await res.json();
            renderResults(data);
            } catch (err) {
            console.error('Search error:', err);
            dropdown.hidden = true;
            }
        }

        function renderResults(novels) {
            if (!novels.length) {
            dropdown.innerHTML = '<div class="rd-search-empty">No novels found</div>';
            dropdown.hidden = false;
            input.setAttribute('aria-expanded', 'true');
            return;
            }

            dropdown.innerHTML = novels.map((n, i) => `
            <a href="/novel/${n._id}" 
                class="rd-search-item" 
                role="option" 
                id="rd-search-opt-${i}"
                aria-selected="false">
                <div class="rd-search-cover" style="--cover:url('${n.imageUrl}')"></div>
                <div class="rd-search-info">
                <div class="rd-search-title">${n.title}</div>
                <div class="rd-search-meta">
                    <span><i class="fa-solid fa-user"></i> ${n.author || 'Unknown'}</span>
                    ${n.categ ? `<span><i class="fa-solid fa-tag"></i> ${n.categ}</span>` : ''}
                </div>
                </div>
            </a>
            `).join('');

            dropdown.hidden = false;
            input.setAttribute('aria-expanded', 'true');
            activeIndex = -1;
        }

        // Input event
        input.addEventListener('input', debounce((e) => {
            fetchResults(e.target.value.trim());
        }, 300));

        // Keyboard navigation
        input.addEventListener('keydown', (e) => {
            const items = dropdown.querySelectorAll('.rd-search-item');
            if (!items.length) return;

            if (e.key === 'ArrowDown') {
            e.preventDefault();
            activeIndex = Math.min(activeIndex + 1, items.length - 1);
            updateActive(items);
            } else if (e.key === 'ArrowUp') {
            e.preventDefault();
            activeIndex = Math.max(activeIndex - 1, -1);
            updateActive(items);
            } else if (e.key === 'Enter' && activeIndex >= 0) {
            e.preventDefault();
            items[activeIndex].click();
            } else if (e.key === 'Escape') {
            dropdown.hidden = true;
            input.setAttribute('aria-expanded', 'false');
            activeIndex = -1;
            }
        });

        function updateActive(items) {
            items.forEach((item, i) => {
            if (i === activeIndex) {
                item.setAttribute('aria-selected', 'true');
                item.focus();
                input.setAttribute('aria-activedescendant', item.id);
            } else {
                item.setAttribute('aria-selected', 'false');
            }
            });
            if (activeIndex === -1) input.removeAttribute('aria-activedescendant');
        }

        // Close on outside click
        document.addEventListener('click', (e) => {
            if (!input.contains(e.target) && !dropdown.contains(e.target)) {
            dropdown.hidden = true;
            input.setAttribute('aria-expanded', 'false');
            }
        });
        })();
    </script>
    <script>
        function toggleStaffCarddesktop() {
        const card = document.getElementById('userCarddesktop');
        card.style.display = card.style.display === 'block' ? 'none' : 'block';
        }

        function toggleStaffCardmobile() {
        const card = document.getElementById('userCardmobile');
        card.style.display = card.style.display === 'block' ? 'none' : 'block';
        }

        // Close BOTH cards if clicked outside
        document.addEventListener('click', function(event) {
        const avatarDesktop = document.querySelector('#userCarddesktop')?.previousElementSibling;
        const cardDesktop = document.getElementById('userCarddesktop');

        const avatarMobile = document.querySelector('#userCardmobile')?.previousElementSibling;
        const cardMobile = document.getElementById('userCardmobile');

        const clickedInsideDesktop = cardDesktop?.contains(event.target) || avatarDesktop?.contains(event.target);
        const clickedInsideMobile = cardMobile?.contains(event.target) || avatarMobile?.contains(event.target);

        if (!clickedInsideDesktop && cardDesktop) cardDesktop.style.display = 'none';
        if (!clickedInsideMobile && cardMobile) cardMobile.style.display = 'none';
        });
    </script>

    <script>
        let darkmode = localStorage.getItem('darkmode')
        const themeSwitches = document.querySelectorAll('#theme-switch')

        const enableDarkmode = () => {
        document.body.classList.add('darkmode') 
        localStorage.setItem('darkmode', 'active')
        }

        const disableDarkmode = () => {
        document.body.classList.remove('darkmode')
        localStorage.setItem('darkmode', null)
        }

        if (darkmode === "active") enableDarkmode()

        themeSwitches.forEach(btn => {
        btn.addEventListener("click", () => {
            darkmode = localStorage.getItem('darkmode')
            darkmode !== "active" ? enableDarkmode() : disableDarkmode()
        })
        })
    </script>

    <script>
        // Toggle mobile menu
        const mobileMenuBtn = document.getElementById('mobileMenuBtn');
        const mobileMenu = document.getElementById('mobileMenu');
        
        mobileMenuBtn.addEventListener('click', (e) => {
        e.stopPropagation(); // Prevent immediate closing
        mobileMenu.classList.toggle('active');
        });
        
        // Close mobile menu when clicking outside
        document.addEventListener('click', (e) => {
        if (!mobileMenu.contains(e.target) && e.target !== mobileMenuBtn) {
            mobileMenu.classList.remove('active');
        }
        });
        
        // Prevent mobile menu from closing when clicking inside it
        mobileMenu.addEventListener('click', (e) => {
        e.stopPropagation();
        });
    </script>

</body>
</html>

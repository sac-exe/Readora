    <!-- Edit Profile Modal -->
    <div id="editProfileModal" class="modal-overlay">
        <div class="modal-content">
            <button class="modal-close" onclick="closeEditProfileModal()">&times;</button>
            <h2>Update Profile</h2>
            <form id="editProfileForm" enctype="multipart/form-data">
                <div class="modal-avatar-section" style="position:relative; display:inline-block;">
                    <img id="profileImagePreview" src="{{profileImageUrl}}" class="modal-avatar-img" style="cursor:pointer;">
                    <button type="button" id="deleteProfileImageBtn" class="delete-image-btn" title="Remove photo">
                        <i class="fa-solid fa-trash"></i>
                    </button>
                    <button type="button" id="changePhotoBtn" class="change-photo-btn">
                        <i class="fa-solid fa-camera"></i> Change Photo
                    </button>
                    <input type="file" id="profileImageInput" name="profileImage" accept="image/*" style="display:none;">
                </div>
                <div class="modal-field">
                    <label for="UserName">Display Name</label>
                    <input type="text" id="UserName" name="Username" maxlength="20" value="{{user.Username}}" required>
                    <span id="charCount">0/20</span>
                </div>
                <div class="modal-actions">
                    <button type="button" class="modal-cancel" onclick="closeEditProfileModal()">Cancel</button>
                    <button type="submit" class="modal-save">Update Profile</button>
                </div>
            </form>
        </div>
    </div>

    <!--Daily reward popup modal-->
    <div class="dr-overlay" id="drOverlay" aria-hidden="true">
        <div class="dr-modal" role="dialog" aria-labelledby="drTitle" aria-modal="true">
            <button class="dr-close" id="drClose" aria-label="Close" onclick="closeDailyreward()"><i class="fa-regular fa-circle-xmark"></i></button>
            <div class="dr-hero">
                <div class="dr-coin-glow"></div>
                <div class="dr-coin">
                    <i class="fa-solid fa-coins"></i>
                </div>
            </div>
            <h2 class="dr-title" id="drTitle">Daily Reward</h2>
            <p class="dr-sub">Claim 1 coin every day</p>

            <div class="dr-card">
                <div class="dr-row">
                    <span class="dr-label">Today’s reward</span>
                    <span class="dr-value">+1 coin</span>
                </div>
                <div class="dr-row">
                    <span class="dr-label">Current balance</span>
                    <span class="dr-balance" id="drBalance">{{coinCount}}</span>
                </div>
            </div>

            <button class="dr-claim" id="drClaim">
            <i class="fa-solid fa-gift"></i> Claim now
            </button>

            <div class="dr-note" id="drNote">One claim per day (UTC)</div>
        </div>
    </div>
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const originalUsername = "{{staff.Username}}".trim();

            // Open modal when Edit Profile is clicked
            document.querySelectorAll('.custom-account-item > div').forEach(item => {
                if (item.textContent.includes('Edit profile')) {
                    item.onclick = () => {
                        document.getElementById('editProfileModal')?.classList.add('active');
                        const input = document.getElementById('UserName');
                        if (input) {
                            input.value = originalUsername;
                            document.getElementById('charCount').textContent = input.value.length + "/20";
                        }
                    };
                }
            });

            // Char count live update
            const nameInput = document.getElementById('UserName');
            nameInput?.addEventListener('input', function () {
                const cc = document.getElementById('charCount');
                if (cc) cc.textContent = this.value.length + "/20";
            });

            // Elements for image change
            const imgPreview = document.getElementById('profileImagePreview');
            const fileInput  = document.getElementById('profileImageInput');
            const changeBtn  = document.getElementById('changePhotoBtn');
            const form       = document.getElementById('editProfileForm');

            // Avatar opens picker
            imgPreview?.addEventListener('click', () => fileInput?.click());
            if (changeBtn && fileInput) {
                changeBtn.addEventListener('click', (e) => {
                    e.preventDefault();
                    fileInput.click();
                });
            }

            // Image preview on file select
            fileInput?.addEventListener('change', function (e) {
                const file = e.target.files?.[0];
                if (file && imgPreview) {
                    imgPreview.src = URL.createObjectURL(file);
                }
            });

            // AJAX submit for profile update
            form && (form.onsubmit = async function (e) {
                e.preventDefault();
                const fd = new FormData(this);
                const incoming = (fd.get('Username') || '').toString().trim();
                if (incoming === originalUsername) fd.delete('Username');
                try {
                    const res = await fetch('/staff/profile/edit', { method:'POST', body: fd });
                    const ct = res.headers.get('content-type') || '';
                    if (ct.includes('application/json')) {
                        const data = await res.json();
                        if (res.ok) location.reload(); else alert(data.error || 'Update failed');
                    } else {
                        await res.text(); alert('Session may have expired. Please log in again.');
                    }
                } catch(err) {
                    console.error(err); alert('Something went wrong while updating.');
                }
            });

            // Delete profile image
            const deleteBtn = document.getElementById('deleteProfileImageBtn');
            if (deleteBtn && imgPreview) {
                deleteBtn.addEventListener('click', async function () {
                    if (!confirm("Remove your profile photo?")) return;
                    try {
                        const res = await fetch('/staff/profile/remove-photo', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            credentials: 'include'
                        });
                        const result = await res.json();
                        if (result.success) {
                            imgPreview.src = ""; // Remove image preview
                            imgPreview.alt = "No profile photo";
                            deleteBtn.style.display = "none";
                        } else {
                            alert("Failed to remove photo.");
                        }
                    } catch (err) {
                        alert("Error removing photo.");
                    }
                });
            }

            // Modal close logic
            window.closeEditProfileModal = function () {
                document.getElementById('editProfileModal')?.classList.remove('active');
            };

            // Prevent clicks inside the modal content from closing or interfering
            const modalOverlay = document.getElementById('editProfileModal');
            const modalContent = modalOverlay?.querySelector('.modal-content');

            // Click on overlay (outside content) closes modal
            modalOverlay?.addEventListener('click', (e) => {
                if (!modalContent?.contains(e.target)) {
                    window.closeEditProfileModal();
                }
            });

            // Stop propagation when clicking inside modal
            modalContent?.addEventListener('click', (e) => e.stopPropagation());

            // Wire Cancel button
            const cancelBtn = modalOverlay?.querySelector('.modal-cancel');
            cancelBtn?.addEventListener('click', (e) => {
                e.preventDefault();
                window.closeEditProfileModal();
            });
        });
    </script>

    <script>
        function toggleStaffCarddesktop() {
            const card = document.getElementById('userCarddesktop');
            card.style.display = card.style.display === 'block' ? 'none' : 'block';
        }

        function toggleStaffCardmobile() {
            const card = document.getElementById('userCardmobile');
            card.style.display = card.style.display === 'block' ? 'none' : 'block';
        }

        // Close BOTH cards if clicked outside
        document.addEventListener('click', function(event) {
            const avatarDesktop = document.querySelector('#userCarddesktop')?.previousElementSibling;
            const cardDesktop = document.getElementById('userCarddesktop');

            const avatarMobile = document.querySelector('#userCardmobile')?.previousElementSibling;
            const cardMobile = document.getElementById('userCardmobile');

            const clickedInsideDesktop = cardDesktop?.contains(event.target) || avatarDesktop?.contains(event.target);
            const clickedInsideMobile = cardMobile?.contains(event.target) || avatarMobile?.contains(event.target);

            if (!clickedInsideDesktop && cardDesktop) cardDesktop.style.display = 'none';
            if (!clickedInsideMobile && cardMobile) cardMobile.style.display = 'none';
        });
    </script>

    <script>
        let darkmode = localStorage.getItem('darkmode')
        const themeSwitches = document.querySelectorAll('#theme-switch')

        const enableDarkmode = () => {
            document.body.classList.add('darkmode') 
            localStorage.setItem('darkmode', 'active')
        }

        const disableDarkmode = () => {
            document.body.classList.remove('darkmode')
            localStorage.setItem('darkmode', null)
        }

        if (darkmode === "active") enableDarkmode()

        themeSwitches.forEach(btn => {
            btn.addEventListener("click", () => {
            darkmode = localStorage.getItem('darkmode')
            darkmode !== "active" ? enableDarkmode() : disableDarkmode()
            })
        })
    </script>

    <script>
        // Toggle mobile menu
        const mobileMenuBtn = document.getElementById('mobileMenuBtn');
        const mobileMenu = document.getElementById('mobileMenu');
        
        mobileMenuBtn.addEventListener('click', (e) => {
        e.stopPropagation(); // Prevent immediate closing
        mobileMenu.classList.toggle('active');
        });
        
        // Close mobile menu when clicking outside
        document.addEventListener('click', (e) => {
        if (!mobileMenu.contains(e.target) && e.target !== mobileMenuBtn) {
            mobileMenu.classList.remove('active');
        }
        });
        
        // Prevent mobile menu from closing when clicking inside it
        mobileMenu.addEventListener('click', (e) => {
        e.stopPropagation();
        });
    </script>
    <script>
        (() => {
            const tile = document.querySelector('.custom-reward-item');
            const overlay = document.getElementById('drOverlay');
            const closeBtn = document.getElementById('drClose');
            const claimBtn = document.getElementById('drClaim');
            const balanceEl = document.getElementById('drBalance');
            const noteEl = document.getElementById('drNote');

            if (!tile || !overlay || !closeBtn || !claimBtn || !balanceEl) return;

            function openModal(){
                overlay.classList.add('show');
                document.body.style.overflow = 'hidden';
            }
            function closeModal(){
                overlay.classList.remove('show');
                document.body.style.overflow = '';
            }

            tile.addEventListener('click', openModal);
            
            overlay.addEventListener('click', (e) => {
                if (e.target === overlay) closeModal();
            });

            claimBtn.addEventListener('click', async () => {
                claimBtn.disabled = true;
                claimBtn.textContent = 'Claiming...';
                try {
                const res = await fetch('/staff/rewards/daily', { method: 'POST', credentials: 'include' });
                const data = await res.json();
                if (!data.ok && res.status === 401) {
                    noteEl.textContent = 'Login required to claim.';
                    return;
                }
                if (data.ok) {
                    balanceEl.textContent = data.coins;
                    const navbar = document.getElementById('navbarCoinCount');
                    if (navbar) navbar.textContent = data.coins;
                    if (data.claimed) {
                    claimBtn.textContent = 'Claimed';
                    noteEl.textContent = 'Come back tomorrow!';
                    } else {
                    claimBtn.textContent = 'Already claimed';
                    noteEl.textContent = data.message || 'Already claimed today';
                    }
                } else {
                    claimBtn.textContent = 'Try again';
                    noteEl.textContent = data.error || 'Something went wrong';
                    claimBtn.disabled = false;
                }
                } catch (e) {
                claimBtn.textContent = 'Try again';
                noteEl.textContent = 'Network error';
                claimBtn.disabled = false;
                }
            });
            closeBtn?.addEventListener('click', (e) => {
                e.preventDefault();
                window.closeDailyreward();
            });
            window.closeDailyreward = window.closeDailyreward || function () {
                const overlay = document.getElementById('drOverlay');
                if (!overlay) return;
                overlay.classList.remove('show');
                document.body.style.overflow = '';
            };
        })();
    </script>

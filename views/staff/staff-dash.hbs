<!DOCTYPE html>                                <!--Author Dashboard-->
<html lang="en">                               <!--Author Dashboard-->
<head>                                         <!--Author Dashboard-->
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Readora: {{staff}} Dashboard</title>
  <!-- Font Awesome for icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body>
  <div class="bg-staff-dash">
    <!-- Mobile Menu Toggle -->
    <button class="menu-toggle-staff-dash" id="menuToggle">
      <i class="fas fa-bars"></i>
    </button>

    <!-- Sidebar Navigation -->
    <aside class="sidebar-staff-dash" id="sidebar">
      <div class="sidebar-header-staff-dash">
        <div class="nav-home">
          <a href="/staff" class="icon-navbar">
            <i class="fas fa-home"></i>
          </a>
        </div>
      </div>
      <div class="sidebar-headerr-staff-dash">
        <div class="sidebar-title-staff-dash"> {{staff}}</div>    
        <button class="collapse-btn-staff-dash" id="collapseBtn">
          <i class="fas fa-chevron-left icon-navbar"></i>
        </button>
      </div>
      
      <ul class="nav-menu-staff-dash">
        <li class="nav-item-staff-dash">
          <a href="#" class="nav-link-staff-dash active" data-section="manage-novels">
            <i class="fas fa-book"></i>
            <span>Manage Novels</span>
          </a>
        </li>
        {{!-- <li class="nav-item-staff-dash">
          <a href="#" class="nav-link-staff-dash" data-section="earnings-history">
            <i class="fas fa-chart-line"></i>
            <span>Earnings History</span>
          </a>
        </li> --}}
        <li class="nav-item-staff-dash">
          <a href="#" class="nav-link-staff-dash" data-section="comments">
            <i class="fas fa-comment"></i>
            <span>Comments</span>
          </a>
        </li>
        <li class="nav-item-staff-dash">
          <a href="#" class="nav-link-staff-dash" data-section="statistics">
            <i class="fas fa-chart-pie"></i>
            <span>Statistics</span>
          </a>
        </li>
        <li class="nav-item-staff-dash">
          <a href="#" class="nav-link-staff-dash" data-section="supportlinks">
            <i class="fas fa-link"></i>
            <span>Support Links</span>
          </a>
        </li>
      </ul>
      
      <div class="theme-switcher d-flex flex-row">
        <div class="theme-title">Theme</div>
        <div class="theme-options">
          <button class="icon-navbar"  id="theme-switch">
              <svg xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#e3e3e3"><path d="M480-120q-150 0-255-105T120-480q0-150 105-255t255-105q14 0 27.5 1t26.5 3q-41 29-65.5 75.5T444-660q0 90 63 153t153 63q55 0 101-24.5t75-65.5q2 13 3 26.5t1 27.5q0 150-105 255T480-120Z"/></svg>
              <svg xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#e3e3e3"><path d="M480-280q-83 0-141.5-58.5T280-480q0-83 58.5-141.5T480-680q83 0 141.5 58.5T680-480q0 83-58.5 141.5T480-280ZM200-440H40v-80h160v80Zm720 0H760v-80h160v80ZM440-760v-160h80v160h-80Zm0 720v-160h80v160h-80ZM256-650l-101-97 57-59 96 100-52 56Zm492 496-97-101 53-55 101 97-57 59Zm-98-550 97-101 59 57-100 96-56-52ZM154-212l101-97 55 53-97 101-59-57Z"/></svg>
          </button>
        </div>
      </div>
    </aside>

    <!-- Main Content Area -->

    <main class="main-content-staff-dash">
      <div id="section-manage-novels" class="dashboard-section" style="display:block;">
        <div class="header-staff-dash">
          <div class="header-staff-dash-row">
            <h1 class="page-title-staff-dash">Novel Management</h1>
            <a href="/staff/novels/add" class="add-btn-staff-dash">+ Add New Novel</a>
          </div>
        </div>
        
        <div class="search-bar-staff-dash">
          <input type="text" class="search-input-staff-dash" placeholder="Search novels...">
        </div>
        
        {{#if hasNovels}}
          
          <div class="novel-list-staff-dash" id="novelList">
            {{#each novels}}
              <div class="novel-item-staff-dash" data-title="{{this.title}}">
                <img src="{{this.imageUrl}}" alt="{{this.title}}" class="img-novel-staff">
                <div class="novel-info-staff-dash">
                  <div>
                    <div class="novel-title-staff-dash">{{this.title}}</div>
                    <div class="novel-author-staff-dash">Author: {{this.author}}</div>
                    <div class="novel-author-staff-dash">Category: {{this.categ}}</div>
                    {{!-- <div class="novel-description-staff-dash">{{this.description}}</div> --}}
                    <div class="novel-meta-staff-dash">
                      <span class="chapters-count">{{this.chapters}} Chapters</span>
                      <span class="status-badge">{{this.status}}</span>
                      <span class="rating-badge">{{this.audience}}</span>
                      <span class="language-badge">{{this.orglang}}</span>
                      <i class="fa-solid fa-arrow-right-arrow-left"></i>
                      <span class="language-badge">{{this.tralang}}</span>
                    </div>
                    
                    <div class="novel-author-staff-dash">Translation done by: {{this.staff}}</div>
                  </div>
                  <div class="novel-actions-staff-dash">
                    <a href="/staff/novels/{{this._id}}/edit" class="edit-btn-staff-dash">Edit</a>
                    <form action="/staff/novels/{{this._id}}/delete" method="POST" class="inline-form" onsubmit="return confirm('Are you sure you want to delete this novel?');">
                      <button type="submit" class="icon-delete">
                        <i class="fa-solid fa-trash-can"></i>
                      </button>
                    </form>
                  </div>
                </div>
              </div>
            {{/each}}
          </div>
          
          {{#if totalPages}}
            <div class="pagination-staff-dash">
              {{#if (gt currentPage 1)}}
                <a href="/staff/dash?page={{subtract currentPage 1}}">&laquo; Prev</a>
              {{/if}}

              {{#each (range 1 totalPages)}}
                <a href="/staff/dash?page={{this}}" class="{{#if (eq ../currentPage this)}}active{{/if}}">{{this}}</a>
              {{/each}}

              {{#if (lt currentPage totalPages)}}
                <a href="/staff/dash?page={{add currentPage 1}}">Next &raquo;</a>
              {{/if}}
            </div>
          {{/if}}
        {{else}}
          <div class="no-novels-message">
            No novels found. 
            <a href="/staff/novels/add">Add your first novel</a>
          </div>
        {{/if}}
      </div>
      {{!-- <div id="section-earnings-history" class="dashboard-section" style="display:none;">
        <h2>Earnings History</h2>
        <p>Show earnings history here...</p>
      </div> --}}
      
      <div id="section-comments" class="dashboard-section" style="display:none;">
        <div class="staffc-head">
          <h2 class="staffc-title">All Comments on Your Novels</h2>
          <div class="staffc-tools">
            <input type="search" class="staffc-search" id="staffcSearch" placeholder="Search comments or novels...">
          </div>
        </div>

        {{#if staffComments.length}}
          <div class="staffc-groups" id="staffcGroups">
            {{#each staffComments}}
              <section class="staffc-group" data-novel="{{this.title}}">
                <header class="staffc-group-head">
                  <div class="staffc-novel">
                    {{#if this.imageUrl}}
                      <img class="staffc-cover" src="{{this.imageUrl}}" alt="{{this.title}}">
                    {{else}}
                      <div class="staffc-cover ph"></div>
                    {{/if}}
                    <h3 class="staffc-novel-title">{{this.title}}</h3>
                  </div>
                  <a class="staffc-view" href="/novelS/{{this.novelId}}" target="_blank" rel="noopener">Open novel</a>
                </header>

                {{#if this.comments.length}}
                  <ul class="staffc-list">
                    {{#each this.comments}}
                      <li class="staffc-item" data-user="{{this.username}}">
                        <div class="staffc-avatar">
                          {{#if this.profileImageUrl}}
                            <img src="{{this.profileImageUrl}}" alt="{{this.username}}">
                          {{else}}
                            <span>{{this.username.[0]}}</span>
                          {{/if}}
                        </div>
                        <div class="staffc-body">
                          <div class="staffc-row">
                            <span class="staffc-name">{{this.username}}</span>
                            <span class="staffc-dot">•</span>
                            <time class="staffc-date">{{this.createdDate}}</time>
                          </div>
                          <div class="staffc-content">{{this.content}}</div>
                        </div>
                      </li>
                    {{/each}}
                  </ul>
                {{else}}
                  <div class="staffc-empty">No comments yet for this novel.</div>
                {{/if}}
              </section>
            {{/each}}
          </div>
        {{else}}
          <div class="staffc-none">
            <p>No comments found for your novels.</p>
          </div>
        {{/if}}
      </div>

      <div id="section-statistics" class="dashboard-section" style="display:none;">
        <h2>Statistics</h2>
        <p>Show statistics here...</p>
      </div>
      <div id="section-supportlinks" class="dashboard-section bg-support-link" style="display:none;">
        <div class="support-sec-container">
          
          <h4 class="profile-header">Manage Profile</h4>
          
          <form id="supportLinksForm">
            <div class="support-sec">
              <div class="support-sec-title">Bio</div>
              <div class="description-box-profile">
                <textarea id="bioField" name="bio" rows="5" cols="100" placeholder="Enter your bio…">{{staff.bio}}</textarea>
              </div>
              <p class="char-limit">Maximum 1000 characters</p>
            </div>
      
            <div class="support-sec">
              <div class="support-sec-title">Ko-fi URL</div>
              <div class="url-option">
                <i class="fa-solid fa-mug-hot"></i>
                <input type="text" id="kofiField" name="kofi" class="url-input" placeholder="https://ko-fi.com/yourusername" value="{{staff.kofi}}">
              </div>
              
              <div class="support-sec-title" style="margin-top: 20px;">Patreon URL</div>
              <div class="url-option">
                <i class="fa-brands fa-patreon"></i>
                <input type="text" id="patreonField" name="patreon" class="url-input" placeholder="https://patreon.com/yourusername" value="{{staff.patreon}}">
              </div>
            </div>
          
            <button id="saveSupportBtn" type="button" class="support-sec-save-btn">Save Profile</button>
            <span id="saveSupportMsg" style="margin-left:12px;"></span>
          </form>
        </div>
      </div>
    </main>
  </div>

  <script>
    document.querySelectorAll('.nav-link-staff-dash').forEach(link => {
      link.addEventListener('click', function(e) {
        e.preventDefault();
        // Remove active from all
        document.querySelectorAll('.nav-link-staff-dash').forEach(l => l.classList.remove('active'));
        this.classList.add('active');
        // Hide all sections
        document.querySelectorAll('.dashboard-section').forEach(sec => sec.style.display = 'none');
        // Show the selected section
        const section = this.getAttribute('data-section');
        document.getElementById('section-' + section).style.display = 'block';
      });
    });
  </script>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const input = document.getElementById('staffcSearch');
      const groupsWrap = document.getElementById('staffcGroups');
      if (!input || !groupsWrap) return;

      input.addEventListener('input', () => {
        const q = input.value.trim().toLowerCase();
        const groups = groupsWrap.querySelectorAll('.staffc-group');
        groups.forEach(g => {
          const novel = (g.getAttribute('data-novel') || '').toLowerCase();
          const items = g.querySelectorAll('.staffc-item');
          let anyVisible = false;

          items.forEach(li => {
            const user = (li.getAttribute('data-user') || '').toLowerCase();
            const txt = li.querySelector('.staffc-content')?.textContent.toLowerCase() || '';
            const match = !q || novel.includes(q) || user.includes(q) || txt.includes(q);
            li.style.display = match ? '' : 'none';
            if (match) anyVisible = true;
          });

          // Hide entire group if no visible items and query set
          g.style.display = (!q || anyVisible) ? '' : 'none';
        });
      });
    });
  </script>

  <script>
    document.querySelector('.search-input-staff-dash').addEventListener('input', function() {
      const query = this.value.trim().toLowerCase();
      const list = document.getElementById('novelList');
      const items = Array.from(list.children);

      // Separate matches and non-matches
      const matches = [];
      const nonMatches = [];

      items.forEach(item => {
        const title = item.getAttribute('data-title').toLowerCase();
        if (title.includes(query)) {
          matches.push(item);
        } else {
          nonMatches.push(item);
        }
      });

      // Clear and re-append in order: matches first, then non-matches
      list.innerHTML = '';
      matches.forEach(item => list.appendChild(item));
      nonMatches.forEach(item => list.appendChild(item));
    });
  </script>
  
  <script>
    document.addEventListener('DOMContentLoaded', function() {
      const menuToggle = document.getElementById('menuToggle');
      const sidebar = document.getElementById('sidebar');
      const collapseBtn = document.getElementById('collapseBtn');
      
      // Desktop behavior
      function handleDesktop() {
        // Hide hamburger in desktop view
        menuToggle.style.display = 'none';
        
        // Collapse button functionality for desktop
        collapseBtn.addEventListener('click', function(e) {
          e.stopPropagation();
          sidebar.classList.toggle('collapsed');
          
          // Change icon direction
          const icon = collapseBtn.querySelector('i');
          if (sidebar.classList.contains('collapsed')) {
            icon.classList.remove('fa-chevron-left');
            icon.classList.add('fa-chevron-right');
          } else {
            icon.classList.remove('fa-chevron-right');
            icon.classList.add('fa-chevron-left');
          }
        });
      }
      
      // Mobile behavior
      function handleMobile() {
        // Show hamburger in mobile view
        menuToggle.style.display = 'block';
        
        // Hide collapse button in mobile view
        collapseBtn.style.display = 'none';
        
        // Hamburger toggle functionality
        menuToggle.addEventListener('click', function() {
          sidebar.classList.add('show');
        });
        
        // Close sidebar when clicking outside
        document.addEventListener('click', function(e) {
          if (!sidebar.contains(e.target) && e.target !== menuToggle) {
            sidebar.classList.remove('show');
          }
        });
      }
      
      // Check screen size and set appropriate behavior
      function checkScreenSize() {
        if (window.innerWidth > 768) {
          handleDesktop();
        } else {
          handleMobile();
        }
      }
      
      // Initial check
      checkScreenSize();
      
      // Update on resize
      window.addEventListener('resize', checkScreenSize);
    });
  </script>

  <script>
    (function(){
      const btn = document.getElementById('saveSupportBtn');
      const msg = document.getElementById('saveSupportMsg');
      const form = document.getElementById('supportLinksForm');
      if (!btn || !form) return;

      btn.addEventListener('click', async () => {
        btn.disabled = true;
        msg.textContent = 'Saving...';
        const payload = {
          bio: document.getElementById('bioField').value,
          kofi: document.getElementById('kofiField').value,
          patreon: document.getElementById('patreonField').value
        };
        try {
          const res = await fetch('/staff/profile/supportlinks', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            credentials: 'same-origin',
            body: JSON.stringify(payload)
          });
          const data = await res.json();
          if (res.ok && data.ok) {
            msg.textContent = 'Saved.';
            setTimeout(()=> msg.textContent = '', 2500);
          } else {
            msg.textContent = data?.msg || 'Save failed';
          }
        } catch (e) {
          console.error('Save support links error', e);
          msg.textContent = 'Server error';
        } finally {
          btn.disabled = false;
        }
      });
    })();
  </script>

  <script>
    let darkmode = localStorage.getItem('darkmode')
    const themeSwitches = document.querySelectorAll('#theme-switch')

    const enableDarkmode = () => {
      document.body.classList.add('darkmode') 
      localStorage.setItem('darkmode', 'active')
    }

    const disableDarkmode = () => {
      document.body.classList.remove('darkmode')
      localStorage.setItem('darkmode', null)
    }

    if (darkmode === "active") enableDarkmode()

    themeSwitches.forEach(btn => {
      btn.addEventListener("click", () => {
        darkmode = localStorage.getItem('darkmode')
        darkmode !== "active" ? enableDarkmode() : disableDarkmode()
      })
    })
  </script>
</body>
</html>
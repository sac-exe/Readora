        <div id="section-manage-novels" class="dashboard-section">
          <form action="/staff/novels/{{novel._id}}" method="POST" enctype="multipart/form-data" id="edit-novel-form">
            <div class="create-novel-container">
              <!-- Header -->
              <div class="create-novel-header">
                <button class="collapse-btn-staff-dash" onclick="window.location.href='/staff/dash'">
                  <i class="fas fa-chevron-left icon-navbar"></i>
                </button>
                <button type="submit" class="create-btn">Save Changes</button>
              </div>
              <div class="novel-form-container">
                <div >

                  <!-- Upload Cover -->
                  <div class="upload-cover">
                    <label for="cover-upload" class="upload-box">
                      <i class="fas fa-image"></i>
                      <p>Upload JPG, or PNG (max 5MB)</p>
                      <input type="file" id="cover-upload" name="cover" accept="image/jpeg,image/png,image/webp" style="display:none;" />
                      <img id="cover-preview" src="{{novel.imageUrl}}" class="img-cover-staff" style="{{#unless novel.imageUrl}}display:none;{{/unless}}"/>
                    </label>
                  </div>

                </div>
                <div class="novel-form-section">

                  <!-- Title & Author -->
                  <input type="text" name="title" placeholder="Enter your novel title" class="novel-title" required value="{{novel.title}}">
                  <input type="text" name="author" placeholder="Enter original author name" class="author-name" required value="{{novel.author}}">

                  <!-- tags -->
                  <div class="tag-container" id="hashtagBox">
                    <div class="tag-input-wrap">
                      <input type="text" id="tagsInput" name="tags" class="tag-input" placeholder="Add tags… (press Enter)" aria-label="Add hashtags" />
                    </div>
                    <input type="hidden" name="hashtags" id="hashtagsInput" value="{{novel.tags}}" />
                  </div>

                  <!-- Categories -->
                  <div class="meta-buttons">
                    <button type="button" class="category-btn" id="btn-category" data-group="categ"><span>Add Categories</span></button>
                    <input type="hidden" name="category" id="categoryInput" required>
                  </div>

                  <div class="form-options-container">
                    <!-- Status Options -->
                    <div class="status-options">
                      <button type="button" class="status-btn active" data-group="status"><i class="fa-solid fa-pencil"></i><span>Ongoing</span></button>
                      <button type="button" class="status-btn" data-group="status"><i class="fa-solid fa-circle-check"></i><span>Completed</span></button>
                      <button type="button" class="status-btn" data-group="status"><i class="fa-solid fa-circle-pause"></i><span>Hiatus</span></button>
                      <button type="button" class="status-btn" data-group="status"><i class="fa-solid fa-circle-xmark"></i><span>Dropped</span></button>
                      <input type="hidden" name="status" id="status-input" value="{{novel.status}}" required>
                    </div>

                    <div class="language-options">
                      <button type="button" class="translate-btn" id="btn-original" data-group="orglang">
                        <i class="fa-solid fa-language"></i>
                        <span>Original Language</span>
                      </button>
                      
                      <button type="button" class="translate-btn" id="btn-translated" data-group="tralang">
                        <i class="fa-solid fa-language"></i>
                        <span>Translated Language</span>
                      </button>
                      <input type="hidden" name="originalLanguage" id="originalLanguageInput" required value="{{novel.orglang}}">
                      <input type="hidden" name="translatedLanguage" id="translatedLanguageInput" required value="{{novel.tralang}}">
                    </div>

                    <!-- Age Rating -->
                    <div class="audience-options">
                      <button type="button" class="audience-btn active" data-group="audience"><i class="fa-solid fa-users"></i><span>Everyone</span></button>
                      <button type="button" class="audience-btn" data-group="audience"><i class="fa-solid fa-user-graduate"></i><span>Teen</span></button>
                      <button type="button" class="audience-btn" data-group="audience"><i class="fa-solid fa-user-plus"></i><span>Mature</span></button>
                      <button type="button" class="audience-btn" data-group="audience"><i class="fa-solid fa-user-tie"></i><span>Adult</span></button>
                      <input type="hidden" name="audience" id="audience-input" value="{{novel.audience}}" required>
                    </div>
                    <div class="description-box">
                      <textarea class="description" placeholder="Enter your novel description here…" name="description" required>{{novel.description}}</textarea>
                    </div>
                  </div>
                </div>
              </div>
              <div class="chapter-box">
                <div class="rd-chaptersbar"> 
                  <div class="rd-chaptersbar__left" > 
                    <button type="button" id="rdAddChapter" class="rd-btn rd-btn--pill" onclick="window.location.href=('/staff/novels/add-ch?novelId={{novel._id}}')"> Add Chapter </button>
                  </div> 
                  <div class="rd-chaptersbar__right"> 

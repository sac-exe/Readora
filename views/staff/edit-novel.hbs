                    </label>
                    <div class="rd-count" id="rdChaptersCount"><span>{{chaptersCount}}</span> chapters</div>
                  </div>
                </div>
                <div class="chapter-list" id="rdChaptersList">
                  <!--in here added chapters are shown-->
                </div>
              </div>
              
            </div>


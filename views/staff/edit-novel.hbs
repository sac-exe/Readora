  <script>
    (function() {
      const box = document.getElementById('hashtagBox');
      const input = document.getElementById('tagsInput');
      const hidden = document.getElementById('hashtagsInput');

      // Optional: preload suggestions; keep empty if not needed.
      // Example: const SUGGESTIONS = ['action','romance','fantasy','sci-fi','thriller','drama','comedy','wuxia','xianxia'];
      const SUGGESTIONS = [];

      let tags = [];

      function normalizeTag(str) {
        // Trim, collapse spaces, remove leading #, lowercase for uniqueness but keep original casing for display
        const raw = str.trim().replace(/\s+/g, ' ');
        const noHash = raw.replace(/^#/, '');
        return noHash;
      }

      function isValidTag(str) {
        // Basic rules: letters, numbers, spaces and dashes/underscores, 1–30 chars after normalization
        const n = normalizeTag(str);
        if (!n) return false;
        if (n.length > 30) return false;
        // Customize allowed chars here
        return /^[A-Za-z0-9 _-]+$/.test(n);
      }

      function existsTag(str) {
        const key = normalizeTag(str).toLowerCase();
        return tags.some(t => t.toLowerCase() === key);
      }

      function updateHidden() {
        hidden.value = tags.join(',');
      }

      function createChip(label) {
        const chip = document.createElement('span');
        chip.className = 'tag-chip';
        chip.innerHTML = `<span class="hash">#</span><span class="text"></span><span class="tag-remove" title="Remove">&times;</span>`;
        chip.querySelector('.text').textContent = label;
        chip.querySelector('.tag-remove').addEventListener('click', () => {
          // Remove from state
          tags = tags.filter(t => t.toLowerCase() !== label.toLowerCase());
          // Remove from DOM
          chip.remove();
          updateHidden();
        });
        // Insert before input wrapper so input stays at the end
        const inputWrap = box.querySelector('.tag-input-wrap');
        box.insertBefore(chip, inputWrap);
        return chip;
      }

      function addTag(str) {
        if (!isValidTag(str)) {
          pulseInput();
          return;
        }
        if (existsTag(str)) {
          pulseDuplicate(str);
          return;
        }
        const normalized = normalizeTag(str);
        tags.push(normalized);
        createChip(normalized);
        updateHidden();
      }

      function pulseInput() {
        input.style.transition = 'box-shadow 0.15s';
        input.style.boxShadow = '0 0 0 2px #ff2f5c66';
        setTimeout(() => { input.style.boxShadow = 'none'; }, 180);
      }

      function pulseDuplicate(str) {
        // Find chip for duplicate and pulse it
        const chips = box.querySelectorAll('.tag-chip .text');
        for (const el of chips) {
          if (el.textContent.toLowerCase() === normalizeTag(str).toLowerCase()) {
            const chip = el.closest('.tag-chip');
            chip.classList.add('pulse');
            setTimeout(() => chip.classList.remove('pulse'), 250);
            break;
          }
        }
      }

      function handleSubmitTokenization(value) {
        // Split on commas, or treat whole string as single tag
        const parts = value.split(',').map(s => s.trim()).filter(Boolean);
        if (parts.length === 0) return;
        parts.forEach(addTag);
        input.value = '';
      }

      // Key handling: Enter or comma to add; Backspace on empty to remove last
      input.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ',') {
          e.preventDefault();
          const val = input.value.trim();
          if (val) handleSubmitTokenization(val);
        } else if (e.key === 'Backspace' && input.value === '') {
          // remove last tag
          const last = box.querySelector('.tag-chip:last-of-type');
          if (last) {
            const text = last.querySelector('.text').textContent;
            tags = tags.filter(t => t.toLowerCase() !== text.toLowerCase());
            last.remove();
            updateHidden();
          }
        }
      });

      // If user types a comma (in input), also handle via input event
      input.addEventListener('input', () => {
        // If contains a comma, split immediately
        if (input.value.includes(',')) {
          const val = input.value;
          handleSubmitTokenization(val);
        }
      });

      // Optional: basic suggestions dropdown (appears below input)
      // Keep this simple; only shows when SUGGESTIONS has items.
      let suggBox;
      function ensureSuggBox() {
        if (suggBox) return suggBox;
        suggBox = document.createElement('div');
        suggBox.className = 'tag-suggestion';
        suggBox.style.display = 'none';
        box.appendChild(suggBox);
        return suggBox;
      }

      function showSuggestions(q) {
        if (!SUGGESTIONS.length) return hideSuggestions();
        const list = SUGGESTIONS
          .filter(s => s.toLowerCase().includes(q.toLowerCase()))
          .filter(s => !existsTag(s))
          .slice(0, 8);
        const sb = ensureSuggBox();
        sb.innerHTML = '';
        if (!q || list.length === 0) return hideSuggestions();
        list.forEach(item => {
          const row = document.createElement('div');
          row.className = 'tag-suggestion-item';
          row.textContent = `# ${item}`;
          row.addEventListener('click', () => {
            addTag(item);
            hideSuggestions();
            input.value = '';
            input.focus();
          });
          sb.appendChild(row);
        });
        sb.style.display = 'block';
      }
      function hideSuggestions() {
        if (suggBox) suggBox.style.display = 'none';
      }

      input.addEventListener('input', () => {
        const q = input.value.trim();
        showSuggestions(q);
      });
      input.addEventListener('blur', () => {
        setTimeout(hideSuggestions, 150);
      });

      // Public helpers (if you need them later)
      window.getHashtags = () => [...tags];
      window.setHashtags = (arr) => {
        // Clear all
        box.querySelectorAll('.tag-chip').forEach(el => el.remove());
        tags = [];
        (arr || []).forEach(addTag);
      };
    })();
  </script>
  <script>

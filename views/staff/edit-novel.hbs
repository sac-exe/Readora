    let selectedCategories = [];

    function renderCategoryList(items) {
      categoryListEl.innerHTML = '';
      items.forEach(cat => {
        const row = document.createElement('div');
        row.className = 'lang-item';
        row.setAttribute('role', 'option');
        row.setAttribute('data-code', cat.code);
        row.innerHTML = `
          <label>
            <input type="checkbox" value="${cat.code}" />
            <span class="lang-name">${cat.name}</span>
            <span class="lang-sub">${cat.code}</span>
          </label>
        `;
        const checkbox = row.querySelector('input[type="checkbox"]');
        checkbox.checked = selectedCategories.includes(cat.code);
        checkbox.addEventListener('change', () => {
          if (checkbox.checked) {
            if (!selectedCategories.includes(cat.code)) selectedCategories.push(cat.code);
          } else {
            selectedCategories = selectedCategories.filter(c => c !== cat.code);
          }
          categoryApplyBtn.disabled = selectedCategories.length === 0;
        });
        categoryListEl.appendChild(row);
      });
    }

    // Filter
    categorySearchEl.addEventListener('input', () => {
      const q = categorySearchEl.value.trim().toLowerCase();
      const filtered = CATEGORIES.filter(c =>
        c.name.toLowerCase().includes(q) ||
        (c.code && c.code.toLowerCase().includes(q))
      );
      renderCategoryList(filtered);
    });

    // Apply -> set button label, mark as selected, store hidden value, close
    categoryApplyBtn.addEventListener('click', () => {
      if (!selectedCategories.length) return;

      // Show count instead of names:
      const span = btnCategory.querySelector('span');
      if (selectedCategories.length === 1) {
        const cat = CATEGORIES.find(c => c.code === selectedCategories[0]);
        span.textContent = cat ? cat.name : selectedCategories[0];
      } else {
        span.textContent =  `${selectedCategories.length} categories`;
      }

      btnCategory.classList.add('selected');
      categoryInput.value = selectedCategories.join(',');
      categoryStatusEl.textContent = selectedCategories.length + ' categories selected!';
      categoryStatusEl.style.color = '#4ef272';
      setTimeout(closeCategoryModal, 250);
    });

    // Openers/closers
    btnCategory.addEventListener('click', () => {
      renderCategoryList(CATEGORIES);
      categoryModal.style.display = 'block';
      categoryModal.classList.add('show');
      categoryModal.setAttribute('aria-hidden', 'false');
      setTimeout(() => categorySearchEl.focus(), 40);
    });
    categoryModalClose.addEventListener('click', closeCategoryModal);
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && categoryModal.classList.contains('show')) closeCategoryModal();
    });
    categoryModal.addEventListener('click', (e) => {
      if (e.target === categoryModal) closeCategoryModal();
    });

    function closeCategoryModal() {
      categoryModal.classList.remove('show');
      categoryModal.setAttribute('aria-hidden', 'true');
      categoryModal.style.display = 'none';
    }
  </script>


  <script>
    // Language data (sample; extend as needed)
    const LANGUAGES = [
      { code: 'en', name: 'English', native: 'English' },
      { code: 'hi', name: 'Hindi', native: 'हिन्दी' },
      { code: 'es', name: 'Spanish', native: 'Español' },
      { code: 'fr', name: 'French', native: 'Français' },
      { code: 'de', name: 'German', native: 'Deutsch' },
      { code: 'zh', name: 'Chinese (Simplified)', native: '简体中文' },
      { code: 'zh-TW', name: 'Chinese (Traditional)', native: '繁體中文' },
      { code: 'ja', name: 'Japanese', native: '日本語' },
      { code: 'ko', name: 'Korean', native: '한국어' },
      { code: 'ar', name: 'Arabic', native: 'العربية' },
      { code: 'pt', name: 'Portuguese', native: 'Português' },
      { code: 'ru', name: 'Russian', native: 'Русский' },
      { code: 'it', name: 'Italian', native: 'Italiano' },
      { code: 'bn', name: 'Bengali', native: 'বাংলা' },
      { code: 'te', name: 'Telugu', native: 'తెలుగు' },
      { code: 'ta', name: 'Tamil', native: 'தமிழ்' },
      { code: 'mr', name: 'Marathi', native: 'मराठी' },
      { code: 'tr', name: 'Turkish', native: 'Türkçe' },
      { code: 'vi', name: 'Vietnamese', native: 'Tiếng Việt' },
      { code: 'ur', name: 'Urdu', native: 'اردو' }
    ];

    // Elements
    const modal = document.getElementById('languageModal');
    const modalClose = document.getElementById('languageModalCloseBtn');
    const modalTitle = document.getElementById('languageModalTitle');
    const listEl = document.getElementById('languageList');
    const searchEl = document.getElementById('languageSearch');
    const statusEl = document.getElementById('languageStatus');
    const applyBtn = document.getElementById('languageApply');
    const btnOriginal = document.getElementById('btn-original');
    const btnTranslated = document.getElementById('btn-translated');

    // State
    let activeTarget = null; // 'original' | 'translated'
    let selected = null;

    function openModal(target) {
      activeTarget = target;
      modalTitle.textContent = target === 'original' ? 'Choose Original Language' : 'Choose Translated Language';
      selected = null;
      applyBtn.disabled = true;
      statusEl.textContent = '';
      searchEl.value = '';
      renderList(LANGUAGES);
      modal.classList.add('show');
      modal.setAttribute('aria-hidden', 'false');
      setTimeout(() => searchEl.focus(), 40);
    }

    function closeModal() {
      modal.classList.remove('show');
      modal.setAttribute('aria-hidden', 'true');
      selected = null;
    }

    function renderList(items) {
      listEl.innerHTML = '';
      items.forEach(lang => {
        const row = document.createElement('div');
        row.className = 'lang-item';
        row.setAttribute('role', 'option');
        row.setAttribute('data-code', lang.code);
        row.innerHTML = `
          <div>
            <div class="lang-name">${lang.name}</div>
            <div class="lang-sub">${lang.native}${lang.code ? ' · ' + lang.code : ''}</div>
          </div>
          <div class="lang-right"><i class="fa-solid fa-check"></i></div>
        `;
        row.addEventListener('click', () => {
          selected = lang;
          applyBtn.disabled = false;
          // Mark active
          [...listEl.querySelectorAll('.lang-item')].forEach(el => el.classList.remove('active'));
          row.classList.add('active');
        });
        listEl.appendChild(row);
      });
    }

    // Filter
    searchEl.addEventListener('input', () => {
      const q = searchEl.value.trim().toLowerCase();
      const filtered = LANGUAGES.filter(l =>
        l.name.toLowerCase().includes(q) ||
        l.native.toLowerCase().includes(q) ||
        (l.code && l.code.toLowerCase().includes(q))
      );
      renderList(filtered);
    });

    // Apply -> set the button label and close
    applyBtn.addEventListener('click', () => {
      if (!selected || !activeTarget) return;
      const targetBtn = activeTarget === 'original' ? btnOriginal : btnTranslated;
      targetBtn.querySelector('span').textContent = selected.name;
      targetBtn.classList.add('selected');
      if (activeTarget === 'original') {
        document.getElementById('originalLanguageInput').value = selected.code;
      } else {
        document.getElementById('translatedLanguageInput').value = selected.code;
      }
      statusEl.textContent = 'Language selected!';
      statusEl.style.color = '#4ef272';
      setTimeout(closeModal, 250);
    });

    // Close / Escape / backdrop
    
    modalClose.addEventListener('click', closeModal);
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && modal.classList.contains('show')) closeModal();
    });
    modal.addEventListener('click', (e) => {
      if (e.target === modal) closeModal();
    });

    // Openers
    btnOriginal.addEventListener('click', () => openModal('original'));
    btnTranslated.addEventListener('click', () => openModal('translated'));
  </script>


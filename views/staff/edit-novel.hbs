  <script>
    document.addEventListener('DOMContentLoaded', function() {
      // Set status button
      const status = "{{novel.status}}";
      if (status) {
        document.querySelectorAll('.status-btn').forEach(btn => {
          if (btn.innerText.trim() === status) btn.classList.add('active');
          else btn.classList.remove('active');
        });
        document.getElementById('status-input').value = status;
      }

      // Set audience button
      const audience = "{{novel.audience}}";
      if (audience) {
        document.querySelectorAll('.audience-btn').forEach(btn => {
          if (btn.innerText.trim() === audience) btn.classList.add('active');
          else btn.classList.remove('active');
        });
        document.getElementById('audience-input').value = audience;
      }

      // Set category button label if category exists
      const category = "{{novel.categ}}";
      if (category) {
        const catArr = category.split(',').map(c => c.trim()).filter(Boolean);
        const span = document.getElementById('btn-category').querySelector('span');
        if (catArr.length === 1) {
          // Show single category name
          const catObj = CATEGORIES.find(c => c.code === catArr[0]);
          span.textContent = catObj ? catObj.name : catArr[0];
        } else {
          // Show count for multiple
          span.textContent = `${catArr.length} categories`;
        }
        document.getElementById('categoryInput').value = category;
        document.getElementById('btn-category').classList.add('selected');
      }

      // Set language buttons
      const orglang = "{{novel.orglang}}";
      const tralang = "{{novel.tralang}}";
      if (orglang) {
        // Find language name from LANGUAGES array if available
        const lang = (window.LANGUAGES || []).find(l => l.code === orglang);
        document.getElementById('btn-original').querySelector('span').textContent = lang ? lang.name : orglang;
        document.getElementById('btn-original').classList.add('selected');
        document.getElementById('originalLanguageInput').value = orglang;
      }
      if (tralang) {
        const lang = (window.LANGUAGES || []).find(l => l.code === tralang);
        document.getElementById('btn-translated').querySelector('span').textContent = lang ? lang.name : tralang;
        document.getElementById('btn-translated').classList.add('selected');
        document.getElementById('translatedLanguageInput').value = tralang;
      }
    });
  </script>

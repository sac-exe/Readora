  <!-- THEN initialize with existing tags -->
  <script>
    document.addEventListener('DOMContentLoaded', function() {
      const existingTags = "{{novel.tags}}";
      
      if (existingTags && existingTags !== '') {
        // Split the comma-separated string into an array
        const tagsArray = existingTags.split(',').map(tag => tag.trim()).filter(tag => tag);
        
        // Use the setHashtags function to populate the tags
        if (typeof window.setHashtags === 'function') {
          window.setHashtags(tagsArray);
        } else {
          // If setHashtags is not available yet, wait a bit and try again
          setTimeout(() => {
            if (typeof window.setHashtags === 'function') {
              window.setHashtags(tagsArray);
            }
          }, 100);
        }
      }
    });
  </script>

  <script>//searching
    document.querySelector('.search-chapters').addEventListener('input', function() {
      const query = this.value.trim().toLowerCase();
      const list = document.getElementById('rdChaptersList');
      if (!list) return;
      const items = Array.from(list.children);

      // Separate matches and non-matches
      const matches = [];
      const nonMatches = [];

      items.forEach(item => {
        const title = (item.getAttribute('data-title') || '').toLowerCase();
        if (title.includes(query)) {
          matches.push(item);
          item.style.display = ''; // Show match
        } else {
          nonMatches.push(item);
          item.style.display = 'none'; // Hide non-match
        }
      });

      // Clear and re-append in order: matches first, then non-matches
      //list.innerHTML = '';
      //matches.forEach(item => list.appendChild(item));
      //nonMatches.forEach(item => list.appendChild(item));
    });
  </script>

  <script>//edit button chapter
    document.addEventListener('click', function(e) {
      if (e.target.closest('.chap-edit')) {
        const btn = e.target.closest('.chap-edit');
        const chapterId = btn.getAttribute('data-id');
        window.location.href = `/staff/chapters/${chapterId}/edit`;
      }
    });
  </script>

  <script>//delete chapter
    document.addEventListener('click', async function(e) {
      const btn = e.target.closest('.chap-delete');
      if (!btn) return;
      const chapterId = btn.getAttribute('data-id');
      const novelId = '{{novel._id}}'; // Make sure this is available in your template

      if (confirm('Are you sure you want to delete this chapter?')) {
        const res = await fetch(`/staff/novels/${novelId}/chapters/${chapterId}/delete`, {
          method: 'POST'
        });
        const data = await res.json();
        if (data.success) {
          // Option 1: Reload the page to update chapter count and list
          location.reload();
          // Option 2: Remove the chapter row from DOM and update count (advanced)
        } else {
          alert('Failed to delete chapter.');
        }
      }
    });
    </script>

  <script>
    document.getElementById('rdAddChapter')?.addEventListener('click', () => {
    // TODO: trigger your add-chapter UI
    // After adding, call refreshChapterCount(newCount);
    });

    /* Emit a search event so your chapter list can filter */
    const _rdSearch = document.getElementById('rdSearchChapters');
    _rdSearch?.addEventListener('input', () => {
      const q = _rdSearch.value.trim().toLowerCase();
      window.dispatchEvent(new CustomEvent('rd:chapters:search', { detail:{ query:q } }));
    });

    /* Update count from anywhere in your code */
    function refreshChapterCount(n){
      const el = document.getElementById('rdChaptersCount');
      if (el) {
        const x = Number(n)||0;
        el.textContent = ${x} chapter${x===1?'':'s'};
      }
    }
  </script>

  <script>
    // Toggle mobile menu
    const mobileMenuBtn = document.getElementById('mobileMenuBtn');
    const mobileMenu = document.getElementById('mobileMenu');
    
    mobileMenuBtn.addEventListener('click', (e) => {
      e.stopPropagation(); // Prevent immediate closing
      mobileMenu.classList.toggle('active');
    });
    
    // Close mobile menu when clicking outside
    document.addEventListener('click', (e) => {
      if (!mobileMenu.contains(e.target) && e.target !== mobileMenuBtn) {
        mobileMenu.classList.remove('active');
      }
    });
    
    // Prevent mobile menu from closing when clicking inside it
    mobileMenu.addEventListener('click', (e) => {
      e.stopPropagation();
    });
  </script>

  <script>
    function toggleStaffCarddesktop() {
      const card = document.getElementById('userCarddesktop');
      card.style.display = card.style.display === 'block' ? 'none' : 'block';
    }

    function toggleStaffCardmobile() {
      const card = document.getElementById('userCardmobile');
      card.style.display = card.style.display === 'block' ? 'none' : 'block';
    }

    // Close BOTH cards if clicked outside
    document.addEventListener('click', function(event) {
      const avatarDesktop = document.querySelector('#userCarddesktop')?.previousElementSibling;
      const cardDesktop = document.getElementById('userCarddesktop');

      const avatarMobile = document.querySelector('#userCardmobile')?.previousElementSibling;
      const cardMobile = document.getElementById('userCardmobile');

      const clickedInsideDesktop = cardDesktop?.contains(event.target) || avatarDesktop?.contains(event.target);
      const clickedInsideMobile = cardMobile?.contains(event.target) || avatarMobile?.contains(event.target);

      if (!clickedInsideDesktop && cardDesktop) cardDesktop.style.display = 'none';
      if (!clickedInsideMobile && cardMobile) cardMobile.style.display = 'none';
    });
  </script>

  <script>//small client side validation
    document.getElementById('edit-novel-form').addEventListener('submit', function(e) {
      const btn = this.querySelector('button[type="submit"]');
      btn.disabled = true;
      btn.textContent = 'Saving...';
      const requiredFields = [
        'title',
        'author',
        'category',
        'status',
        'originalLanguage',
        'translatedLanguage',
        'audience'
      ];
      let valid = true;
      requiredFields.forEach(id => {
        const el = document.getElementsByName(id)[0];
        if (!el || !el.value.trim()) {
          valid = false;
          el && el.classList.add('input-error');
        } else {
          el && el.classList.remove('input-error');
        }
      });
      if (!valid) {
        alert('Please fill all required fields.');
        e.preventDefault();
      }
    });
    </script>


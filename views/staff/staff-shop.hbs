      </nav>

      <div class=" d-flex flex-colomn justify-content-center gap-5">
        <div class="shop-container">
          <!-- Tab Slider -->
          <div class="tab-slider-shop">
            <div class="tab-slider-shop-container">
              <div class="tab-slider-shop-bg"></div>
              <div class="tab-slider-shop-options">
                <div class="tab-slider-shop-option active" data-tab="coins">Coins</div>
                <div class="tab-slider-shop-option" data-tab="membership">Membership</div>
              </div>
            </div>
          </div>
          
          <!-- Cards Container -->
          <div class="cards-container-shop">
            <!-- Coins Section -->
            <div class="cards-section-shop coins active">
              <!-- Card 1 -->
              <div class="shop-card" data-product-id="coins_20" role="button" tabindex="0">
                <div class="shop-card-content">
                  <h3 class="shop-card-title">
                    <i class="fa-duotone fa-solid fa-coins fa-2xs" style="--fa-primary-color: #ffca0a; --fa-secondary-color: #ffca0a;"></i>
                    <span>20</span> Coins
                  </h3>
                  <div class="shop-card-price" data-price="2.00">$2</div>
                </div>
              </div>

              <!-- Card 2 -->
              <div class="shop-card" data-product-id="coins_50" role="button" tabindex="0">
                <div class="shop-card-content">
                  <h3 class="shop-card-title">
                    <i class="fa-duotone fa-solid fa-coins fa-2xs" style="--fa-primary-color: #ffca0a; --fa-secondary-color: #ffca0a;"></i>
                    <span>50</span> Coins
                  </h3>
                  <div class="shop-card-price" data-price="5.00">$5</div>
                </div>
              </div>

              <!-- Card 3 -->
              <div class="shop-card" data-product-id="coins_100" role="button" tabindex="0">
                <div class="shop-card-content">
                  <h3 class="shop-card-title">
                    <i class="fa-duotone fa-solid fa-coins fa-2xs" style="--fa-primary-color: #ffca0a; --fa-secondary-color: #ffca0a;"></i>
                    <span>100</span> Coins
                  </h3>
                  <div class="shop-card-price" data-price="10.00">$10</div>
                </div>
              </div>

              <!-- Second Row of Coins -->
              <div class="shop-card" data-product-id="coins_300" role="button" tabindex="0">
                <div class="shop-card-content">
                  <h3 class="shop-card-title">
                    <i class="fa-duotone fa-solid fa-coins fa-2xs" style="--fa-primary-color: #ffca0a; --fa-secondary-color: #ffca0a;"></i>
                    <span>300</span> Coins
                  </h3>
                  <div class="shop-card-price" data-price="25.00">$25</div>
                </div>
              </div>

              <div class="shop-card" data-product-id="coins_500" role="button" tabindex="0">
                <div class="shop-card-content">
                  <h3 class="shop-card-title">
                    <i class="fa-duotone fa-solid fa-coins fa-2xs" style="--fa-primary-color: #ffca0a; --fa-secondary-color: #ffca0a;"></i>
                    <span>500</span> Coins
                  </h3>
                  <div class="shop-card-price" data-price="50.00">$50</div>
                </div>
              </div>

              <div class="shop-card special-card-shop" data-product-id="coins_2000" role="button" tabindex="0">
                <div class="shop-card-content">
                  <h6>Best Value</h6>
                  <h3 class="shop-card-title">
                    <i class="fa-duotone fa-solid fa-coins fa-2xs" style="--fa-primary-color: #ffca0a; --fa-secondary-color: #ffca0a;"></i>
                    <span>2000</span> Coins
                  </h3>
                  <div class="shop-card-price" data-price="160.00">$160</div>
                </div>
              </div>
            </div>

            <!-- Membership Section -->
            <div class="cards-section-shop membership">
              <!-- Membership Card 1 -->
              <div class="shop-card" data-product-id="membership_silver" role="button" tabindex="0">
                <div class="shop-card-content">
                  <h3 class="shop-card-title-member">Silver Quill</h3>
                  <div class="shop-card-price" data-price="5.00">5$/month</div>
                  <div class="shop-card-details">
                    <p><i class="fa-solid fa-feather-pointed"></i> Weekly name change option</p>
                    <p><i class="fa-solid fa-feather-pointed"></i> Exclusive silver frame</p>
                    <p><i class="fa-solid fa-feather-pointed"></i> 60 Coins</p>
                  </div>
                </div>
              </div>

              <!-- Membership Card 2 -->
              <div class="shop-card" data-product-id="membership_gold" role="button" tabindex="0">
                <div class="shop-card-content">
                  <h3 class="shop-card-title-member">Golden Tome</h3>
                  <div class="shop-card-price" data-price="10.00">10$/month</div>
                  <div class="shop-card-details">
                    <p><i class="fa-solid fa-feather-pointed"></i> Weekly name change option</p>
                    <p><i class="fa-solid fa-feather-pointed"></i> Exclusive Golden badge</p>
                    <p><i class="fa-solid fa-feather-pointed"></i> 120 Coins</p>
                  </div>
                </div>
              </div>

              <!-- Membership Card 3 -->
              <div class="shop-card" data-product-id="membership_obsidian" role="button" tabindex="0">
                <div class="shop-card-content">
                  <h3 class="shop-card-title-member">Obsedian Edition</h3>
                  <div class="shop-card-price" data-price="25.00">25$/month</div>
                  <div class="shop-card-details">
                    <p><i class="fa-solid fa-feather-pointed"></i> Weekly name change option</p>
                    <p><i class="fa-solid fa-feather-pointed"></i> Exclusive Obsedian badge</p>
                    <p><i class="fa-solid fa-feather-pointed"></i> 300 Coins</p>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script>
    document.addEventListener('DOMContentLoaded', function() {
      const tabOptions = document.querySelectorAll('.tab-slider-shop-option');
      const tabBg = document.querySelector('.tab-slider-shop-bg');
      const coinsSection = document.querySelector('.cards-section-shop.coins');
      const membershipSection = document.querySelector('.cards-section-shop.membership');
      
      tabOptions.forEach(option => {
        option.addEventListener('click', function() {
          // Update active tab
          tabOptions.forEach(opt => opt.classList.remove('active'));
          this.classList.add('active');
          
          // Move background
          if (this.dataset.tab === 'coins') {
            tabBg.style.transform = 'translateX(0)';
            coinsSection.classList.add('active');
            coinsSection.style.transform = 'translateX(0)';
            membershipSection.classList.remove('active');
            membershipSection.style.transform = 'translateX(100%)';
          } else {
            tabBg.style.transform = 'translateX(100%)';
            coinsSection.classList.remove('active');
            coinsSection.style.transform = 'translateX(-100%)';
            membershipSection.classList.add('active');
            membershipSection.style.transform = 'translateX(0)';
          }
        });
      });
    });
  </script>

  <script src="https://checkout.razorpay.com/v1/checkout.js"></script>
  <script>
    (function () {
      async function beginCheckout(productId, button) {
        button.disabled = true;
        try {
          const orderResponse = await fetch('/payment/create-order', {
            method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ productId })
          });
          const order = await orderResponse.json();
          if (!orderResponse.ok) throw new Error(order.error || 'Could not create payment order.');
          const checkout = new Razorpay({
            key: order.keyId, amount: order.amount, currency: order.currency, order_id: order.orderId,
            name: 'Readora', description: order.product.name,
            handler: async function (response) {
              try {
                const verifyResponse = await fetch('/payment/verify', {
                  method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(response)
                });
                const result = await verifyResponse.json();
                if (!verifyResponse.ok || !result.success) throw new Error(result.error || 'Payment verification failed.');
                window.alert('Payment verified. Your purchase has been applied.');
                window.location.reload();
              } catch (error) {
                window.alert(error.message || 'Payment verification failed.');
                button.disabled = false;
              }
            },
            modal: { ondismiss: function () { button.disabled = false; } }
          });
          checkout.open();
        } catch (error) {
          window.alert(error.message || 'Unable to start checkout.');
          button.disabled = false;
        }
      }
      document.querySelectorAll('[data-product-id]').forEach(function (card) {
        const button = document.createElement('button');
        button.type = 'button'; button.className = 'shop-card-button'; button.textContent = 'Buy';
        button.addEventListener('click', function (event) { event.stopPropagation(); beginCheckout(card.dataset.productId, button); });
        card.querySelector('.shop-card-content').appendChild(button);
        card.addEventListener('keydown', function (event) { if (event.key === 'Enter' || event.key === ' ') { event.preventDefault(); button.click(); } });
      });
    }());
  </script>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

  {{#if loginSuccess}}
  <div id="loginSuccessPopup" class="popup-message show">
    <i class="fa-solid fa-circle-check" style="color:#28a745; font-size:22px; margin-right:8px;"></i>
    {{loginSuccess}}
  </div>
  <script>
    setTimeout(() => {
      const popup = document.getElementById('loginSuccessPopup');
      if (popup) {
        popup.classList.remove('show');
        popup.classList.add('hide');
      }
    }, 2000);
  </script>
  {{/if}}

  {{#if signinSuccess}}
  <div id="signinSuccessPopup" class="popup-message show">
    <i class="fa-solid fa-circle-check" style="color:#28a745; font-size:22px; margin-right:8px;"></i>
    {{signinSuccess}}
  </div>
  <script>
    setTimeout(() => {
      const popup = document.getElementById('signinSuccessPopup');
      if (popup) {
        popup.classList.remove('show');
        popup.classList.add('hide');
      }
    }, 2000);
  </script>
  {{/if}}

  <script>
    function toggleStaffCarddesktop() {
      const card = document.getElementById('userCarddesktop');
      card.style.display = card.style.display === 'block' ? 'none' : 'block';
    }

    function toggleStaffCardmobile() {
      const card = document.getElementById('userCardmobile');
      card.style.display = card.style.display === 'block' ? 'none' : 'block';
    }

    // Close BOTH cards if clicked outside
    document.addEventListener('click', function(event) {
      const avatarDesktop = document.querySelector('#userCarddesktop')?.previousElementSibling;
      const cardDesktop = document.getElementById('userCarddesktop');

      const avatarMobile = document.querySelector('#userCardmobile')?.previousElementSibling;
      const cardMobile = document.getElementById('userCardmobile');

      const clickedInsideDesktop = cardDesktop?.contains(event.target) || avatarDesktop?.contains(event.target);
      const clickedInsideMobile = cardMobile?.contains(event.target) || avatarMobile?.contains(event.target);

      if (!clickedInsideDesktop && cardDesktop) cardDesktop.style.display = 'none';
      if (!clickedInsideMobile && cardMobile) cardMobile.style.display = 'none';
    });
  </script>

  <script>
    let darkmode = localStorage.getItem('darkmode')
    const themeSwitches = document.querySelectorAll('#theme-switch')

    const enableDarkmode = () => {
      document.body.classList.add('darkmode') 
      localStorage.setItem('darkmode', 'active')
    }

    const disableDarkmode = () => {
      document.body.classList.remove('darkmode')
      localStorage.setItem('darkmode', null)
    }

    if (darkmode === "active") enableDarkmode()

    themeSwitches.forEach(btn => {
      btn.addEventListener("click", () => {
        darkmode = localStorage.getItem('darkmode')
        darkmode !== "active" ? enableDarkmode() : disableDarkmode()
      })
    })
  </script>

  <script>
    // Toggle mobile menu
    const mobileMenuBtn = document.getElementById('mobileMenuBtn');
    const mobileMenu = document.getElementById('mobileMenu');
    
    mobileMenuBtn.addEventListener('click', (e) => {
      e.stopPropagation(); // Prevent immediate closing
      mobileMenu.classList.toggle('active');
    });
    
    // Close mobile menu when clicking outside
    document.addEventListener('click', (e) => {
      if (!mobileMenu.contains(e.target) && e.target !== mobileMenuBtn) {
        mobileMenu.classList.remove('active');
      }
    });
    
    // Prevent mobile menu from closing when clicking inside it
    mobileMenu.addEventListener('click', (e) => {
      e.stopPropagation();
    });
  </script>
</body>
</html>

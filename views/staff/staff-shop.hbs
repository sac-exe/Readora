                      {{/if}}
                  </div>
                  <div>
                    <div class="user-name">{{staff.Username}}</div>
                  </div>
                </div>
                <div class="user-card-actions">
                  <a href="/staff/profile" class="user-card-link"><i class="fa-solid fa-user"></i> Profile</a>

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Readora-shop: {{staff.Username}}</title>
</head>
<body>
  <div class="bg-shop">
    <div class="container-home" style="overflow: visible;">
      <nav class="navbar">
        <!-- Left Section - Home Icon -->
        <div class="nav-home">
          <a href="/staff" class="icon-navbar">
